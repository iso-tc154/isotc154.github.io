---
import Asciidoctor from '@asciidoctor/core'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import { loadData, type Standard, type Group } from '../../lib/data'
import { standardStatusLabel } from '../../lib/presentation'

const asciidoctor = Asciidoctor()

function renderProse(text?: string | null): string {
  if (!text) return ''
  return String(asciidoctor.convert(text, {
    standalone: false,
    safe: 'safe',
    attributes: { showtitle: false },
  }))
}

export function getStaticPaths() {
  return loadData.standards().map((s) => ({
    params: { id: s.id },
    props: { standard: s },
  }))
}

const { standard } = Astro.props as { standard: Standard }
const iso = standard.iso
const tc154 = standard.tc154
const groups = loadData.groups()


const scopeHtml = renderProse(tc154?.scope || iso.scope)
const introductionHtml = renderProse(tc154?.introduction)

const publicationYear = (() => {
  const d = iso.publication_date
  if (!d) return ''
  const year = parseInt(d.substring(0, 4), 10)
  if (year > 2026 || year < 1900) return ''
  return String(year)
})()

const publicationDate = (() => {
  const d = iso.publication_date
  if (!d || !publicationYear) return ''
  const dt = new Date(d)
  if (Number.isNaN(dt.getTime())) return ''
  return dt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
})()

const groupName = tc154?.group
  ? (groups.find((g: Group) => g.id === tc154.group)?.title ?? tc154.group)
  : ''
const groupUrl = tc154?.group ? `/groups/${tc154.group}/` : null

const isoStoreUrl = iso.store_id ? `https://www.iso.org/standard/${iso.store_id}.html` : ''

const icsList = iso.ics ? iso.ics.split(',').map((s) => s.trim()).filter(Boolean) : []
---
<BaseLayout title={`${iso.name} — ISO/TC 154`} description={iso.title}>
  <article class="detail">
    <PageHero
      variant="detail"
      bleed
      eyebrow={`${iso.name}${publicationYear ? ' (' + publicationYear + ')' : ''}`}
      title={iso.title}
    >
      <div class="detail__badges" slot="default">
        <span class:list={["detail__status", `detail__status--${tc154?.status ?? 'published'}`]}>{standardStatusLabel(tc154?.status ?? 'published')}</span>
        {iso.type && iso.type !== 'international' && <span class="detail__type">{iso.type}</span>}
        {iso.stage && <span class="detail__stage">Stage {iso.stage}</span>}
      </div>
      <a href="/standards/" slot="breadcrumb">
        Standards
      </a>
    </PageHero>

    <div class="detail__grid">
      <div class="detail__main">
        {introductionHtml && (
          <section class="detail__section">
            <h2 class="detail__section-title">Introduction</h2>
            <div class="prose" set:html={introductionHtml} />
          </section>
        )}

        {scopeHtml && (
          <section class="detail__section">
            <h2 class="detail__section-title">Scope</h2>
            <div class="prose" set:html={scopeHtml} />
          </section>
        )}
      </div>

      <aside class="detail__aside">
        <section class="detail__aside-block">
          <h3 class="detail__aside-title">Metadata</h3>
          <dl class="meta">
            {iso.type && (
              <div class="meta__row">
                <dt>Type</dt>
                <dd>{iso.type === 'international' ? 'International Standard' : iso.type}</dd>
              </div>
            )}
            {iso.stage && (
              <div class="meta__row">
                <dt>ISO stage</dt>
                <dd><code>{iso.stage}</code></dd>
              </div>
            )}
            {publicationDate && (
              <div class="meta__row">
                <dt>Published</dt>
                <dd>{publicationDate}</dd>
              </div>
            )}
            {tc154?.group && (
              <div class="meta__row">
                <dt>Responsible group</dt>
                <dd>
                  {groupUrl ? <a href={groupUrl}>{groupName}</a> : <span>{groupName}</span>}
                </dd>
              </div>
            )}
            {icsList.length > 0 && (
              <div class="meta__row">
                <dt>ICS</dt>
                <dd>
                  <ul class="meta__list">
                    {icsList.map((code) => <li><code>{code}</code></li>)}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
        </section>

        {isoStoreUrl && (
          <section class="detail__aside-block">
            <h3 class="detail__aside-title">Get the standard</h3>
            <a href={isoStoreUrl} target="_blank" rel="noopener noreferrer" class="store-link">
              View on ISO Store
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
            </a>
            {iso.store_id && <p class="store-id">ISO Store ID: <code>{iso.store_id}</code></p>}
          </section>
        )}
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .detail {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }
  .detail__loading { color: #78716c; padding: 4rem 0; text-align: center; }
  .detail__body { padding-top: 1.5rem; }
  .detail__back {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-blue-accent);
    text-decoration: none;
  }
  .detail__back:hover { text-decoration: underline; }
  .detail__badges {
    display: flex; flex-wrap: wrap; gap: 0.375rem; align-items: center;
    margin-bottom: 0.75rem;
  }
  .detail__status {
    font-size: 0.6875rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.08em;
    padding: 0.25rem 0.625rem; border-radius: 0.25rem;
    background: #f5f5f4; color: #57534e;
  }
  :global(.dark) .detail__status { background: #292524; color: #d6d3d1; }
  .detail__status--published { background: rgb(16 185 129 / 0.15); color: #047857; }
  :global(.dark) .detail__status--published { background: rgb(16 185 129 / 0.2); color: #6ee7b7; }
  .detail__status--withdrawn { background: #f5f5f4; color: #78716c; }
  :global(.dark) .detail__status--withdrawn { background: #292524; color: #a8a29e; }
  .detail__status--deleted { background: rgb(185 28 28 / 0.1); color: var(--color-iso-red); }
  :global(.dark) .detail__status--deleted { background: rgb(185 28 28 / 0.2); color: #fca5a5; }
  .detail__status--under_development { background: rgb(30 58 138 / 0.1); color: var(--color-blue-accent); }
  :global(.dark) .detail__status--under_development { background: rgb(51 133 214 / 0.2); color: #93c5fd; }
  .detail__type {
    font-size: 0.6875rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.08em;
    padding: 0.25rem 0.625rem; border-radius: 0.25rem;
    background: #e0e7ff; color: var(--color-blue-accent);
  }
  :global(.dark) .detail__type { background: rgb(51 133 214 / 0.2); }
  .detail__stage {
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    color: #78716c;
  }
  :global(.dark) .detail__stage { color: #a8a29e; }

  .detail__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) {
    .detail__grid { grid-template-columns: minmax(0, 1fr) 20rem; }
  }

  .detail__section { margin-bottom: 2rem; }
  .detail__section-title {
    font-size: 0.75rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: #78716c;
    margin: 0 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e7e5e4;
  }
  :global(.dark) .detail__section-title { color: #a8a29e; border-bottom-color: #292524; }

  .prose {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #44403c;
  }
  :global(.dark) .prose { color: #d6d3d1; }
  .prose :global(p) { margin: 0 0 0.875rem; }
  .prose :global(p:last-child) { margin-bottom: 0; }
  .prose :global(a) { color: var(--color-blue-accent); text-decoration: underline; }

  .detail__aside { display: flex; flex-direction: column; gap: 1rem; }
  .detail__aside-block {
    padding: 1.25rem;
    background: #fff;
    border: 1px solid #e7e5e4;
    border-radius: 0.5rem;
  }
  :global(.dark) .detail__aside-block { background: rgb(15 23 42 / 0.5); border-color: #44403c; }
  .detail__aside-title {
    font-size: 0.6875rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: #78716c;
    margin: 0 0 0.875rem;
  }
  :global(.dark) .detail__aside-title { color: #a8a29e; }

  .meta { margin: 0; }
  .meta__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.5rem;
    padding: 0.375rem 0;
    border-bottom: 1px solid #f5f5f4;
  }
  .meta__row:last-child { border-bottom: none; }
  :global(.dark) .meta__row { border-bottom-color: #292524; }
  .meta__row dt {
    font-size: 0.75rem;
    color: #78716c;
    font-weight: 500;
  }
  :global(.dark) .meta__row dt { color: #a8a29e; }
  .meta__row dd {
    margin: 0;
    font-size: 0.875rem;
    color: #1c1917;
  }
  :global(.dark) .meta__row dd { color: #fafaf9; }
  .meta__row dd a {
    color: var(--color-blue-accent);
    text-decoration: none;
  }
  .meta__row dd a:hover { text-decoration: underline; }
  .meta__row code {
    font-family: ui-monospace, monospace;
    font-size: 0.8125rem;
    background: #f5f5f4;
    padding: 0.0625rem 0.25rem;
    border-radius: 0.1875rem;
  }
  :global(.dark) .meta__row code { background: #292524; }
  .meta__list { list-style: none; margin: 0; padding: 0; }
  .meta__list li { margin-bottom: 0.25rem; }

  .store-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    background: var(--color-blue-accent);
    color: #fff;
    border-radius: 0.375rem;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background 0.15s;
  }
  .store-link:hover { background: #172554; }
  :global(.dark) .store-link { background: #5379bf; }
  :global(.dark) .store-link:hover { background: #2a6fae; }
  .store-id {
    margin: 0.625rem 0 0;
    font-size: 0.75rem;
    color: #78716c;
  }
  :global(.dark) .store-id { color: #a8a29e; }
</style>
