---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import { loadData, type Post } from '../../lib/data'

export function getStaticPaths() {
  return loadData.posts().map((p) => ({ params: { slug: p.slug }, props: { post: p } }))
}
const { post } = Astro.props as { post: Post }

const title = post.frontmatter.title
  || post.slug.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')

function formatDate(dateStr: string): string {
  if (!dateStr) return ''
  try {
    const d = new Date(dateStr)
    return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  } catch {
    return dateStr
  }
}
---
<BaseLayout title={`${title} — ISO/TC 154`} description={post.frontmatter.excerpt || title}>
  <div>
    <PageHero
      variant="article"
      bleed
      eyebrow={formatDate(post.date)}
      title={title}
    >
      <a href="/posts/" slot="breadcrumb">
        News &amp; posts
      </a>
      {post.frontmatter.categories && (
        <div class="post__tags" slot="default">
          <span class="post__tag">{post.frontmatter.categories}</span>
        </div>
      )}
    </PageHero>

    <article class="page page--wide">
      <div class="post-shell">
        <div class="post__body prose" set:html={post.html} />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .post-shell { max-width: 48rem; }
  .back-link {
    display: inline-block;
    font-size: 0.875rem; font-weight: 500;
    color: var(--color-brand);
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .back-link:hover { text-decoration: underline; }

  .post__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .post__tag {
    font-size: 0.6875rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.05em;
    color: #78716c;
    background: #f5f5f4;
    padding: 0.2rem 0.625rem;
    border-radius: 9999px;
  }
  :global(.dark) .post__tag { color: #a8a29e; background: #44403c; }

  .prose {
    font-size: 1rem; line-height: 1.7;
    color: #44403c;
  }
  :global(.dark) .prose { color: #d6d3d1; }
  .prose :global(h1) {
    font-family: var(--font-serif);
    font-size: 1.875rem; font-weight: 700;
    color: #1c1917;
    margin: 2rem 0 1rem;
    letter-spacing: -0.01em;
  }
  :global(.dark) .prose :global(h1) { color: #fafaf9; }
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.5rem; font-weight: 700;
    color: #1c1917;
    margin: 2rem 0 0.875rem;
    letter-spacing: -0.01em;
  }
  :global(.dark) .prose :global(h2) { color: #fafaf9; }
  .prose :global(h3) {
    font-size: 1.25rem; font-weight: 700;
    color: #1c1917;
    margin: 1.5rem 0 0.625rem;
  }
  :global(.dark) .prose :global(h3) { color: #fafaf9; }
  .prose :global(p) { margin: 0 0 1rem; }
  .prose :global(a) { color: var(--color-brand); text-decoration: underline; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1rem; padding-left: 1.5rem; }
  .prose :global(li) { margin-bottom: 0.375rem; }
  .prose :global(code) {
    font-family: ui-monospace, monospace;
    background: #f5f5f4;
    padding: 0.1rem 0.3rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  :global(.dark) .prose :global(code) { background: #44403c; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--color-brand);
    padding: 0.5rem 1rem;
    margin: 1.5rem 0;
    background: #fafaf9;
    color: #57534e;
    font-style: italic;
  }
  :global(.dark) .prose :global(blockquote) {
    background: #292524;
    color: #d6d3d1;
    border-left-color: #5379bf;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }
  .prose :global(th), .prose :global(td) {
    border: 1px solid #e7e5e4;
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  :global(.dark) .prose :global(th), :global(.dark) .prose :global(td) { border-color: #44403c; }
  .prose :global(th) {
    background: #fafaf9;
    font-weight: 700;
  }
  :global(.dark) .prose :global(th) { background: #292524; }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid #e7e5e4;
    margin: 2rem 0;
  }
  :global(.dark) .prose :global(hr) { border-top-color: #44403c; }

  .loading { color: #78716c; padding: 4rem 0; text-align: center; }
</style>
