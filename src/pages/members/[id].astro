---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import { loadData, type Member, type RoleRecord, type Group } from '../../lib/data'
import { roleLabel, initials, formatDatePrecision } from '../../lib/presentation'
import { renderProse } from '../../lib/prose'

export function getStaticPaths() {
  return Object.values(loadData.members().all).map((m) => ({
    params: { id: m['member-id'] },
    props: { member: m },
  }))
}

const { member } = Astro.props as { member: Member }
const groups = loadData.groups()

const roles: RoleRecord[] = member.roles?._all?.in?._all ?? []
const bioHtml = renderProse(member.bio)
const pictureUrl = member.picture ? `/assets/images/members/${member.picture}` : null
function groupDoc(groupId?: string): Group | undefined {
  if (!groupId) return undefined
  return groups.find((g: Group) => g.id === groupId)
}
function groupName(groupId?: string): string {
  if (!groupId) return ''
  return groupDoc(groupId)?.name ?? groupId
}
function groupTitle(groupId?: string): string {
  if (!groupId) return ''
  return groupDoc(groupId)?.title ?? ''
}
function groupUrl(groupId?: string): string | null {
  return groupId ? `/groups/${groupId}/` : null
}
const fmtDate = (d?: { date?: string; precision?: 'day' | 'month' | 'year' }) =>
  d?.date ? formatDatePrecision(d.date, d.precision) : ''
function memberRoleSpan(r: RoleRecord): string {
  const start = fmtDate(r.from)
  const end = fmtDate(r.to) || 'present'
  return start ? `${start} – ${end}` : end
}
const sortedRoles = [...roles].sort((a, b) => {
  const ag = a.group ?? '~'
  const bg = b.group ?? '~'
  if (ag !== bg) return ag.localeCompare(bg)
  return (a.from?.date ?? '').localeCompare(b.from?.date ?? '')
})

const eyebrow = member.is_the_chair
  ? 'Chair of ISO/TC 154'
  : member.is_in_leadership
    ? 'Leadership'
    : member.is_current
      ? 'Current member'
      : 'Past member'
---
<BaseLayout title={`${member.name} — ISO/TC 154`} description={member.affiliation || member.name}>
  <article class="detail">
    <PageHero
      variant="detail"
      bleed
      eyebrow={eyebrow}
      title={member.name}
      lead={member.affiliation}
    >
      <a href="/members/" slot="breadcrumb">
        Members
      </a>
    </PageHero>

    <div class="member-head">
      <div class:list={["detail__avatar", { 'detail__avatar--deceased': member.deceased }]}>
        {pictureUrl ? (
          <img src={pictureUrl} alt={member.name} />
        ) : (
          <span>{initials(member.name)}</span>
        )}
      </div>
      {member.deceased && <p class="in-memoriam">In Memoriam</p>}
    </div>

    <div class="detail__body">
      {bioHtml && (
        <section class="detail__section">
          <h2 class="detail__section-title">Biography</h2>
          <div class="prose" set:html={bioHtml} />
        </section>
      )}

      {roles.length > 0 && (
        <section class="detail__section">
          <h2 class="detail__section-title">Roles in ISO/TC 154</h2>
          <ul class="roles">
            {sortedRoles.map((r) => (
              <li class="role">
                <div class="role__head">
                  <span class="role__title">{roleLabel(r.id)}</span>
                  {groupUrl(r.group) ? (
                    <a href={groupUrl(r.group)} class="role__group">
                      <span class="role__group-name">{groupName(r.group)}</span>
                      {groupTitle(r.group) && <span class="role__group-title">· {groupTitle(r.group)}</span>}
                    </a>
                  ) : r.group ? (
                    <span class="role__group role__group--plain">
                      <span class="role__group-name">{groupName(r.group)}</span>
                      {groupTitle(r.group) && <span class="role__group-title">· {groupTitle(r.group)}</span>}
                    </span>
                  ) : (
                    <span class="role__group role__group--plain">Committee-wide</span>
                  )}
                </div>
                <span class="role__span">{memberRoleSpan(r)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {member.links?.length && (
        <section class="detail__section">
          <h2 class="detail__section-title">Links</h2>
          <ul class="links">
            {member.links.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label ?? l.title ?? l.url}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .detail {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }
  .detail__loading { color: var(--color-slate-500); padding: 4rem 0; text-align: center; }
  .detail__back {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-blue-accent);
    text-decoration: none;
  }
  .detail__back:hover { text-decoration: underline; }

  .member-head {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: -1rem 0 1.5rem;
    flex-wrap: wrap;
  }
  .detail__avatar {
    width: 6rem; height: 6rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, var(--color-blue-accent), var(--color-blue-steel));
    color: var(--color-white);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1.75rem;
    overflow: hidden;
    flex-shrink: 0;
  }
  .detail__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .detail__avatar--deceased img { filter: grayscale(1); }
  .in-memoriam {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-slate-500);
    margin: 0;
  }
  :global(.dark) .in-memoriam { color: var(--color-slate-400); }

  .detail__body { margin-top: 0; }
  .detail__section { margin-bottom: 2.5rem; }
  .detail__section-title {
    font-size: 0.75rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--color-slate-500);
    margin: 0 0 0.875rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-slate-200);
  }
  :global(.dark) .detail__section-title { color: var(--color-slate-400); border-bottom-color: var(--color-slate-800); }

  .prose {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-slate-700);
  }
  :global(.dark) .prose { color: var(--color-slate-300); }
  .prose :global(p) { margin: 0 0 0.875rem; }
  .prose :global(p:last-child) { margin-bottom: 0; }
  .prose :global(a) { color: var(--color-blue-accent); text-decoration: underline; }

  .roles {
    list-style: none;
    margin: 0; padding: 0;
    display: flex; flex-direction: column;
    gap: 0.5rem;
  }
  .role {
    display: flex; flex-direction: column;
    padding: 0.625rem 0.875rem;
    background: var(--color-slate-50);
    border-radius: 0.5rem;
    border-left: 3px solid var(--color-blue-accent);
  }
  :global(.dark) .role { background: var(--color-slate-800); border-left-color: var(--color-blue-steel); }
  .role__head {
    display: flex; justify-content: space-between;
    align-items: baseline; gap: 0.5rem;
    flex-wrap: wrap;
  }
  .role__title {
    font-size: 0.9375rem; font-weight: 600; color: var(--color-slate-900);
  }
  :global(.dark) .role__title { color: var(--color-slate-50); }
  .role__group {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.875rem; color: var(--color-blue-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .role__group:hover { text-decoration: underline; }
  .role__group-name { font-weight: 600; }
  .role__group-title {
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.8;
  }
  .role__group--plain { color: var(--color-slate-500); }
  :global(.dark) .role__group--plain { color: var(--color-slate-400); }
  .role__span {
    font-size: 0.8125rem; color: var(--color-slate-500);
    font-family: ui-monospace, monospace;
    margin-top: 0.125rem;
  }
  :global(.dark) .role__span { color: var(--color-slate-400); }

  .links {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column;
    gap: 0.375rem;
  }
  .links a {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    background: var(--color-slate-50);
    border-radius: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-blue-accent);
    text-decoration: none;
  }
  .links a:hover { background: var(--color-status-info-bg); }
  :global(.dark) .links a { background: var(--color-slate-800); }
  :global(.dark) .links a:hover { background: var(--color-slate-700); }
</style>
