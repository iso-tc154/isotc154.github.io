---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import { loadData, type Group, type Member } from '../../lib/data'
import { renderProse } from '../../lib/prose'
import { groupCategoryLabel, initials } from '../../lib/presentation'

export function getStaticPaths() {
  return loadData.groups().map((g) => ({
    params: { id: g.id },
    props: { group: g },
  }))
}

const { group } = Astro.props as { group: Group }

const membersIndex = loadData.members().all
const standards = loadData.standards()

const introHtml = renderProse(group.intro)
const scopeHtml = renderProse(group.scope)
const historyStoryHtml = renderProse(group.history?.story)

function standardCard(raw: string) {
  const standard = standards.find((s) => s.iso?.name === raw)
  const id = standard?.id ?? raw.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')
  const d = standard?.iso?.publication_date
  const year = d ? String(d).slice(0, 4) : ''
  return {
    raw,
    url: standard?.url ?? `/standards/${id}/`,
    standard,
    year,
    stage: standard?.iso?.stage ?? '',
  }
}
const standardCards = (group.standards ?? []).map(standardCard)

interface PeopleGroup { id: string; label: string; members: string[] }
const peopleGroups: PeopleGroup[] = []
if (group.convenors?.length) peopleGroups.push({ id: 'convenors', label: 'Convenors', members: group.convenors })
if (group.co_chairs?.length) peopleGroups.push({ id: 'co_chairs', label: 'Co-chairs', members: group.co_chairs })
if (group.managers?.length) peopleGroups.push({ id: 'managers', label: 'Managers', members: group.managers })
if (group.members?.length) peopleGroups.push({ id: 'members', label: 'Members', members: group.members })
if (group.past_members?.length) peopleGroups.push({ id: 'past', label: 'Past members', members: group.past_members })

function nameOf(id: string): string {
  return membersIndex[id]?.name ?? id
}
function pictureOf(id: string): string | undefined {
  const p = membersIndex[id]?.picture
  return p ? `/assets/images/members/${p}` : undefined
}
function deceasedOf(id: string): boolean {
  return Boolean(membersIndex[id]?.deceased)
}

const dissolved = Boolean(group.history?.dissolved)
const status = dissolved ? 'dissolved' : group.inactive ? 'inactive' : 'active'
---
<BaseLayout title={`${group.name ?? group.id.toUpperCase()} — ${group.title ?? ''}`.trim()} description={group.intro || group.title || ''}>
  <article class="group">
    <PageHero
      variant="detail"
      bleed
      eyebrow={groupCategoryLabel(group.category)}
      lead={group.title}
    >
      <span slot="title" class:list={{ 'ghero__title--muted': status === 'dissolved' }}>{group.name}</span>
      <a href="/groups/" slot="breadcrumb">
        Groups
      </a>
    </PageHero>

    <div class="group__body group__body--grid">
      <div class="group__main">
        {(introHtml || historyStoryHtml) && (
          <section class="gsec" id="overview">
            <h2 class="gsec__title">Overview</h2>
            {introHtml && <div class="prose" set:html={introHtml} />}
            {historyStoryHtml && <div class:list={["prose", { 'gover__prose-block': introHtml }]} set:html={historyStoryHtml} />}
          </section>
        )}

        {scopeHtml && (
          <section class="gsec" id="scope">
            <h2 class="gsec__title">Scope</h2>
            <div class="prose" set:html={scopeHtml} />
          </section>
        )}

        {standardCards.length > 0 && (
          <section class="gsec" id="standards">
            <h2 class="gsec__title">Standards</h2>
            <p class="gsec__intro">{standardCards.length === 1 ? '1 standard' : `${standardCards.length} standards`} maintained under this group</p>
            <ul class="gstd__list">
              {standardCards.map((card) => (
                <li class="gstd__item">
                  <a href={card.url} class="gstd__link">
                    <span class="gstd__main">
                      <span class="gstd__code">{card.raw}</span>
                      {card.standard?.iso.title && (
                        <span class="gstd__title">{card.standard.iso.title}</span>
                      )}
                      {(card.year || card.stage) && (
                        <span class="gstd__meta">
                          {card.year && <span class="gstd__year">{card.year}</span>}
                          {card.year && card.stage && <span class="gstd__meta-sep" aria-hidden="true">·</span>}
                          {card.stage && <span class="gstd__stage">{card.stage}</span>}
                        </span>
                      )}
                    </span>
                    <span class="gstd__arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      {peopleGroups.length > 0 && (
        <aside class="group__aside">
          {peopleGroups.map((pg) => (
            <section class="plist">
              <h3 class="plist__title">{pg.label}</h3>
              <div class="plist__grid">
                {pg.members.map((id) => (
                  <a href={`/members/${id}/`} class:list={["pcard", "pcard--sm", { 'pcard--photo': pictureOf(id), 'pcard--deceased': deceasedOf(id) }]}>
                    <span class="pcard__avatar" aria-hidden="true">
                      {pictureOf(id) ? <img src={pictureOf(id)} alt={nameOf(id)} loading="lazy" /> : <span>{initials(nameOf(id))}</span>}
                    </span>
                    <span class="pcard__body">
                      <span class="pcard__name">{nameOf(id)}</span>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .detail {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }
  .detail__loading { color: var(--color-slate-500); padding: 4rem 0; text-align: center; }
  .detail__body { padding-top: 1.5rem; }
  .detail__back {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-blue-accent);
    text-decoration: none;
  }
  .detail__back:hover { text-decoration: underline; }

  .ghero__title--muted { color: var(--color-slate-500); }

  .group__body {
    max-width: 80rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }
  .group__body--grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .group__body--grid { grid-template-columns: minmax(0, 1fr) 22rem; }
  }
  .group__body--single {
    padding-top: 3rem;
  }

  .group__aside {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .group__people-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .gsec {
    margin-bottom: 3rem;
    scroll-margin-top: 9rem;
  }
  .gsec:last-child { margin-bottom: 0; }
  .gsec__title {
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 600;
    color: var(--color-slate-900);
    margin: 0 0 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-slate-200);
    letter-spacing: -0.018em;
    line-height: 1.15;
    font-variation-settings: 'opsz' 32;
  }
  :global(.dark) .gsec__title {
    color: var(--color-slate-100);
    border-top-color: var(--color-slate-700);
  }
  .gsec:first-of-type .gsec__title {
    border-top: none;
    padding-top: 0;
  }
  .gsec__intro {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    color: var(--color-slate-500);
    font-style: italic;
    margin: 0 0 1.5rem;
    line-height: 1.55;
    max-width: 42rem;
  }
  :global(.dark) .gsec__intro { color: var(--color-slate-400); }

  .prose {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-slate-700);
    max-width: 48rem;
  }
  :global(.dark) .prose { color: var(--color-slate-300); }
  .prose :global(p) { margin: 0 0 1rem; }
  .prose :global(p:last-child) { margin-bottom: 0; }
  .prose :global(a) { color: var(--color-blue-accent); text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--font-serif);
    color: var(--color-slate-900);
    margin: 1.5rem 0 0.75rem;
    line-height: 1.3;
  }
  :global(.dark) .prose :global(h2),
  :global(.dark) .prose :global(h3),
  :global(.dark) .prose :global(h4) { color: var(--color-slate-100); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1rem; padding-left: 1.5rem; }
  .prose :global(ul) { list-style: disc outside; }
  .prose :global(ol) { list-style: decimal outside; }
  .prose :global(ul ul), .prose :global(ol ul) { list-style: circle outside; }
  .prose :global(li) { margin-bottom: 0.375rem; }
  .prose :global(code) {
    font-family: ui-monospace, monospace;
    background: var(--color-wash);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  :global(.dark) .prose :global(code) { background: var(--color-slate-800); }

  .gover__prose-block { margin-top: 2rem; }
  .gover__prose-block::before {
    content: '';
    display: block;
    width: 3rem;
    height: 1px;
    background: var(--color-slate-300);
    margin-bottom: 1.5rem;
  }
  :global(.dark) .gover__prose-block::before { background: var(--color-slate-600); }

  .gstd__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .gstd__item {
    background: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: 0.5rem;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  :global(.dark) .gstd__item {
    background: rgba(15, 23, 42, 0.4);
    border-color: var(--color-slate-700);
  }
  .gstd__item:hover {
    border-color: var(--color-blue-accent);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(30, 58, 138, 0.08);
  }
  .gstd__link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    text-decoration: none;
    color: inherit;
  }
  .gstd__main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
  }
  .gstd__code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-slate-900);
    letter-spacing: -0.01em;
  }
  :global(.dark) .gstd__code { color: var(--color-slate-100); }
  .gstd__title {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-slate-600);
    font-style: italic;
    line-height: 1.4;
  }
  :global(.dark) .gstd__title { color: var(--color-slate-300); }
  .gstd__meta {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    font-size: 0.75rem;
    color: var(--color-slate-500);
    margin-top: 0.125rem;
  }
  :global(.dark) .gstd__meta { color: var(--color-slate-400); }
  .gstd__year {
    font-family: var(--font-serif);
    font-style: italic;
  }
  .gstd__meta-sep { color: var(--color-slate-300); }
  :global(.dark) .gstd__meta-sep { color: var(--color-slate-600); }
  .gstd__stage {
    text-transform: capitalize;
    letter-spacing: 0.02em;
  }
  .gstd__arrow {
    flex: 0 0 auto;
    align-self: center;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--color-slate-400);
  }
  .gstd__item:hover .gstd__arrow { color: var(--color-blue-accent); }

  .plist {
    padding: 1.25rem 1.5rem;
    background: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: 0.5rem;
  }
  :global(.dark) .plist {
    background: rgba(15, 23, 42, 0.4);
    border-color: var(--color-slate-700);
  }
  .plist__title {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-slate-500);
    margin: 0 0 0.875rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--color-slate-200);
  }
  :global(.dark) .plist__title {
    color: var(--color-slate-400);
    border-bottom-color: var(--color-slate-700);
  }
  .plist__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .pcard {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.875rem 0.375rem 0.375rem;
    border-radius: 9999px;
    background: var(--color-white);
    border: 1px solid var(--color-slate-200);
    text-decoration: none;
    color: var(--color-slate-900);
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    transition: border-color 0.15s, background 0.15s, transform 0.15s;
  }
  .pcard:hover {
    border-color: var(--color-blue-accent);
    background: var(--color-slate-50);
    transform: translateY(-1px);
  }
  :global(.dark) .pcard {
    background: rgba(15, 23, 42, 0.55);
    border-color: var(--color-slate-700);
    color: var(--color-slate-100);
  }
  :global(.dark) .pcard:hover {
    background: var(--color-slate-800);
    border-color: var(--color-blue-accent);
  }
  .pcard:hover .pcard__name { color: var(--color-blue-accent); }
  .pcard--sm {
    padding: 0.25rem 0.75rem 0.25rem 0.25rem;
    font-size: 0.8125rem;
    gap: 0.5rem;
  }
  .pcard--sm .pcard__avatar {
    width: 1.625rem;
    height: 1.625rem;
    font-size: 0.625rem;
  }
  .pcard--photo .pcard__avatar {
    width: 2.5rem;
    height: 2.5rem;
    font-size: 0.75rem;
  }
  .pcard--sm.pcard--photo .pcard__avatar {
    width: 2.125rem;
    height: 2.125rem;
  }
  .pcard__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: var(--color-blue-accent);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    flex-shrink: 0;
    letter-spacing: 0.02em;
    overflow: hidden;
  }
  :global(.dark) .pcard__avatar { background: var(--color-blue-steel); }
  .pcard__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pcard--deceased .pcard__avatar img { filter: grayscale(1); }
  .pcard__body {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    min-width: 0;
  }
  .pcard__name {
    font-weight: 500;
    color: inherit;
    white-space: nowrap;
  }
</style>
