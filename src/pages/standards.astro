---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import { loadData, type Standard, type Group } from '../lib/data'
import { standardStatusLabel } from '../lib/presentation'

const standards = loadData.standards()
const groups = loadData.groups()

function compareStandards(a: Standard, b: Standard): number {
  const validDate = (s: Standard) => {
    const d = s.iso?.publication_date
    if (!d) return ''
    const year = parseInt(d.substring(0, 4), 10)
    if (year > 2026 || year < 1900) return ''
    return d
  }
  const ad = validDate(a)
  const bd = validDate(b)
  if (ad && bd) return bd.localeCompare(ad)
  if (ad) return -1
  if (bd) return 1
  return (a.iso?.name ?? '').localeCompare(b.iso?.name ?? '', undefined, { numeric: true })
}
const sorted = [...standards].sort(compareStandards)

const statuses = Array.from(new Set(standards.map((s) => s.tc154?.status ?? 'published'))).sort()
const groupIds = Array.from(new Set(standards.filter((s) => s.tc154?.group).map((s) => s.tc154!.group))).sort()
const types = Array.from(new Set(standards.filter((s) => s.iso?.type).map((s) => s.iso!.type))).sort()

function groupLabel(g?: string): string {
  if (!g) return ''
  const grp = groups.find((x: Group) => x.id === g)
  return grp?.title ?? g
}
function publicationYear(s: Standard): string {
  const d = s.iso?.publication_date
  if (!d) return ''
  const year = parseInt(d.substring(0, 4), 10)
  if (year > 2026 || year < 1900) return ''
  return String(year)
}
---
<BaseLayout title="Standards — ISO/TC 154" description="Published International Standards, Technical Specifications, and Technical Reports by ISO/TC 154.">
  <div>
    <PageHero
      variant="index"
      bleed
      eyebrow="Published deliverables"
      title="Standards"
      lead="Published International Standards, Technical Specifications, Technical Reports, and standards under development by ISO/TC 154."
    >
      <div slot="decoration" class="hero-pattern hero-pattern--dots"></div>
      <dl class="page__stats" slot="stats">
        <div><dt>{standards.length}</dt><dd>total</dd></div>
        <div><dt>{statuses.length}</dt><dd>statuses</dd></div>
        <div><dt>{types.length}</dt><dd>deliverable types</dd></div>
      </dl>
    </PageHero>

    <div class="page page--wide">
      <div class="filter">
        <div class="filter__search-wrap">
          <svg class="filter__search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          <input
            type="search"
            class="filter__search"
            id="filter-search"
            placeholder="Search by ISO number, title or ICS code…"
            autocomplete="off"
            spellcheck="false"
            aria-label="Search standards"
          />
        </div>
        <div class="filter__controls">
          <div class="filter__field">
            <span class="filter__label">Status</span>
            <div class="filter__chips" data-facet="status">
              <button type="button" class="chip chip--active" data-value="">All</button>
              {statuses.map((s) => (
                <button type="button" class="chip" data-value={s}>{standardStatusLabel(s)}</button>
              ))}
            </div>
          </div>
          {groupIds.length > 0 && (
            <div class="filter__field">
              <span class="filter__label">Group</span>
              <div class="filter__chips" data-facet="group">
                <button type="button" class="chip chip--active" data-value="">Any</button>
                {groupIds.map((g) => (
                  <button type="button" class="chip" data-value={g}>{g}</button>
                ))}
              </div>
            </div>
          )}
          {types.length > 0 && (
            <div class="filter__field">
              <span class="filter__label">Type</span>
              <div class="filter__chips" data-facet="type">
                <button type="button" class="chip chip--active" data-value="">Any</button>
                {types.map((t) => (
                  <button type="button" class="chip" data-value={t}>{t === 'international' ? 'IS' : t}</button>
                ))}
              </div>
            </div>
          )}
        </div>
        <div class="filter__meta">
          <span id="filter-count">{standards.length} of {standards.length} standards</span>
        </div>
      </div>

      <ul class="grid" id="std-grid">
        {sorted.map((s) => (
          <li
            data-haystack={[(s.iso?.name ?? ''), s.iso?.title ?? '', s.iso?.ics ?? ''].join(' ').toLowerCase()}
            data-status={s.tc154?.status ?? 'published'}
            data-group={s.tc154?.group ?? ''}
            data-type={s.iso?.type ?? ''}
          >
            <a
              href={s.url}
              class:list={["card", `card--${s.tc154?.status ?? 'published'}`]}
            >
              <div class="card__top">
                <span class="card__name">{s.iso?.name}</span>
                {publicationYear(s) && <span class="card__year">{publicationYear(s)}</span>}
              </div>
              <p class="card__title">{s.iso?.title}</p>
              <div class="card__bottom">
                <span class="card__status">{standardStatusLabel(s.tc154?.status ?? 'published')}</span>
                {s.tc154?.group && <span class="card__group">{groupLabel(s.tc154.group)}</span>}
                {s.iso?.type && s.iso.type !== 'international' && <span class="card__type">{s.iso.type}</span>}
              </div>
            </a>
          </li>
        ))}
      </ul>

      <div class="empty" id="std-empty" hidden>
        <h3>No standards match your filters</h3>
        <button type="button" class="chip" id="std-clear">Clear filters</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { mountListFilter } from '../lib/list-filter'
  mountListFilter({
    searchInput: '#filter-search',
    items: '#std-grid > li',
    facetWrappers: '.filter__chips[data-facet]',
    count: '#filter-count',
    countLabel: 'standards',
    empty: '#std-empty',
    clear: '#std-clear',
    initialFromUrl: true,
  })
</script>

<style>
  .filter {
    background: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: 0.75rem;
    padding: 1.25rem;
    margin-bottom: 2rem;
  }
  :global(.dark) .filter { background: rgb(15 23 42 / 0.5); border-color: var(--color-slate-700); }
  .filter__search-wrap { position: relative; margin-bottom: 1rem; }
  .filter__search-icon {
    position: absolute; left: 0.75rem; top: 50%;
    transform: translateY(-50%);
    color: var(--color-slate-400);
    pointer-events: none;
  }
  .filter__search {
    width: 100%;
    padding: 0.625rem 0.875rem 0.625rem 2.25rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-slate-300);
    background: var(--color-slate-50);
    color: var(--color-slate-900);
    font-size: 0.9375rem;
    font-family: inherit;
  }
  .filter__search:focus {
    outline: none;
    border-color: var(--color-blue-accent);
    background: var(--color-white);
    box-shadow: 0 0 0 3px rgb(30 58 138 / 0.15);
  }
  :global(.dark) .filter__search { background: var(--color-slate-800); border-color: var(--color-slate-600); color: var(--color-slate-50); }
  :global(.dark) .filter__search:focus { border-color: var(--color-blue-steel); background: var(--color-slate-900); }
  .filter__controls { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: flex-end; }
  .filter__field { display: flex; flex-direction: column; gap: 0.5rem; }
  .filter__label {
    font-size: 0.75rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--color-slate-500);
  }
  :global(.dark) .filter__label { color: var(--color-slate-400); }
  .filter__meta { margin-top: 1rem; font-size: 0.875rem; color: var(--color-slate-500); }
  :global(.dark) .filter__meta { color: var(--color-slate-400); }

  .loading, .empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--color-slate-500);
  }
  .empty h3 { color: var(--color-slate-900); margin: 0 0 0.75rem; }
  :global(.dark) .empty h3 { color: var(--color-slate-50); }
  :global(.dark) .loading, :global(.dark) .empty { color: var(--color-slate-400); }

  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }

  .card {
    display: block;
    height: 100%;
    padding: 1rem;
    border-radius: 0.625rem;
    border: 1px solid var(--color-slate-200);
    background: var(--color-white);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
    border-left-width: 3px;
  }
  :global(.dark) .card { background: rgb(15 23 42 / 0.5); border-color: var(--color-slate-700); }
  .card--published { border-left-color: var(--color-status-ok-bright); }
  .card--withdrawn { border-left-color: var(--color-slate-400); }
  .card--deleted { border-left-color: var(--color-iso-red); }
  .card--under_development { border-left-color: var(--color-blue-accent); }
  .card:hover {
    border-color: var(--color-blue-accent);
    box-shadow: 0 4px 12px rgb(30 58 138 / 0.08);
    transform: translateY(-2px);
  }
  :global(.dark) .card:hover { border-color: var(--color-blue-steel); box-shadow: 0 4px 12px rgb(0 0 0 / 0.25); }
  .card__top {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 0.5rem; margin-bottom: 0.25rem;
  }
  .card__name {
    font-family: ui-monospace, monospace;
    font-size: 0.9375rem; font-weight: 700;
    color: var(--color-slate-900);
  }
  :global(.dark) .card__name { color: var(--color-slate-50); }
  .card__year {
    font-size: 0.75rem;
    color: var(--color-slate-500);
    flex-shrink: 0;
  }
  :global(.dark) .card__year { color: var(--color-slate-400); }
  .card__title {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-slate-600);
    margin: 0 0 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.dark) .card__title { color: var(--color-slate-300); }
  .card__bottom {
    display: flex; flex-wrap: wrap; gap: 0.375rem;
    align-items: center;
  }
  .card__status {
    font-size: 0.6875rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.06em;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    background: var(--color-wash);
    color: var(--color-slate-600);
  }
  :global(.dark) .card__status { background: var(--color-slate-800); color: var(--color-slate-300); }
  .card__group, .card__type {
    font-size: 0.6875rem;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    background: var(--color-status-info-bg);
    color: var(--color-blue-accent);
    font-weight: 600;
  }
  :global(.dark) .card__group, :global(.dark) .card__type { background: rgb(51 133 214 / 0.2); }
</style>
