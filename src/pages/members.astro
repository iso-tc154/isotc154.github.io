---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import { loadData, type Group } from '../lib/data'
import { roleLabel, initials, formatDatePrecision } from '../lib/presentation'

interface RoleRecord { id?: string; group?: string; to?: unknown }
interface Member {
  'member-id': string
  name: string
  affiliation?: string
  picture?: string
  deceased?: boolean
  url?: string
  is_current?: boolean
  is_the_chair?: boolean
  is_in_leadership?: boolean
  roles?: Record<string, { in?: Record<string, RoleRecord[]> }>
}

const data = loadData.members()
const groups = loadData.groups()
const allMembers = Object.values(data.all as Record<string, Member>)
const sorted = [...allMembers].sort((a, b) => a.name.localeCompare(b.name))

const stats = {
  total: allMembers.length,
  current: allMembers.filter((m) => m.is_current).length,
  leadership: allMembers.filter((m) => m.is_in_leadership).length,
  past: allMembers.filter((m) => !m.is_current).length,
}

function groupLabel(gid: string): string {
  const g = groups.find((x: Group) => x.id === gid)
  return g?.name ?? gid
}

const groupLifecycle = new Map(groups.map((g) => {
  const historical = Boolean(g.inactive || g.dissolved)
  const when = g.dissolved?.date ? formatDatePrecision(g.dissolved.date, g.dissolved.precision as 'day' | 'month' | 'year') : ''
  return [g.id, { historical, title: g.dissolved?.date ? `Dissolved ${when}` : g.inactive ? 'Inactive group' : '' }]
}))
const availableGroups = Array.from(new Set(
  allMembers.flatMap((m) => Object.keys(m.roles?._all?.in ?? {}).filter((g) => g !== '_all'))
)).sort((a, b) => {
  const ha = groupLifecycle.get(a)?.historical ? 1 : 0
  const hb = groupLifecycle.get(b)?.historical ? 1 : 0
  return ha - hb || a.localeCompare(b)
})
const availableRoles = Array.from(new Set(
  allMembers.flatMap((m) => Object.keys(m.roles ?? {}).filter((k) => k !== '_all'))
)).sort()

function memberUrl(m: Member): string {
  return m.url ?? `/members/${m['member-id']}/`
}
function pictureUrl(m: Member): string | null {
  return m.picture ? `/assets/images/members/${m.picture}` : null
}
function primaryRoleLabel(m: Member): string {
  if (m.is_the_chair) return 'Chair'
  const ids = Object.keys(m.roles ?? {}).filter((k) => k !== '_all')
  if (ids.includes('convenor')) return 'Convenor'
  if (ids.includes('manager')) return 'Manager'
  if (ids.includes('chair')) return 'Chair'
  if (ids.includes('member')) return 'Member'
  return ids[0] ? roleLabel(ids[0]) : ''
}
function memberGroups(m: Member): string {
  return Object.keys(m.roles?._all?.in ?? {}).filter((g) => g !== '_all').join('|')
}
function memberRoles(m: Member): string {
  return Object.keys(m.roles ?? {}).filter((k) => k !== '_all').join('|')
}
function hasCurrentRole(records: RoleRecord[] | undefined, past: boolean): boolean {
  if (!records) return false
  return past ? records.some((r) => r?.to != null) : records.some((r) => r?.to == null)
}
---
<BaseLayout title="Members — ISO/TC 154" description="The experts of ISO/TC 154 — current and past.">
  <div>
    <PageHero
      variant="index"
      bleed
      eyebrow="People of TC 154"
      title="Members"
      lead="Experts from national bodies, liaisons, and the Committee Advisory Group who carry out TC 154's technical work — current and past."
    >
      <div slot="decoration" class="hero-pattern hero-pattern--nodes"></div>
      <dl class="page__stats" slot="stats">
        <div><dt>{stats.total}</dt><dd>total</dd></div>
        <div><dt>{stats.current}</dt><dd>current</dd></div>
        <div><dt>{stats.leadership}</dt><dd>in leadership</dd></div>
        <div><dt>{stats.past}</dt><dd>past</dd></div>
      </dl>
    </PageHero>

    <div class="page page--wide">
      <div class="filter">
        <div class="filter__search-wrap">
          <svg class="filter__search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          <input
            type="search"
            class="filter__search"
            id="member-search"
            placeholder="Search by name or affiliation…"
            autocomplete="off"
            spellcheck="false"
            aria-label="Search members"
          />
        </div>
        <div class="filter__controls">
          <div class="filter__field">
            <span class="filter__label">Status</span>
            <div class="filter__chips" data-facet="status">
              <button type="button" class="chip" data-value="">All</button>
              <button type="button" class="chip" data-value="current">Current</button>
              <button type="button" class="chip" data-value="past">Past</button>
              <button type="button" class="chip" data-value="leadership">Leadership</button>
            </div>
          </div>
          {availableRoles.length > 0 && (
            <div class="filter__field">
              <span class="filter__label">Role</span>
              <div class="filter__chips" data-facet="role">
                <button type="button" class="chip chip--active" data-value="">Any</button>
                {availableRoles.map((r) => (
                  <button type="button" class="chip" data-value={r}>{roleLabel(r)}</button>
                ))}
              </div>
            </div>
          )}
          {availableGroups.length > 0 && (
            <div class="filter__field">
              <span class="filter__label">Group</span>
              <span class="filter__hint"><span class="chip__gdot" aria-hidden="true"></span> current <span class="chip__gdot chip__gdot--off" aria-hidden="true"></span> historical</span>
              <div class="filter__chips" data-facet="group">
                <button type="button" class="chip chip--active" data-value="">Any</button>
                {availableGroups.map((g) => {
                  const lc = groupLifecycle.get(g)
                  return (
                    <button type="button" class:list={['chip', { 'chip--historical': lc?.historical }]} data-value={g} title={lc?.title || undefined}>
                      <span class:list={['chip__gdot', { 'chip__gdot--off': lc?.historical }]} aria-hidden="true"></span>
                      {groupLabel(g)}
                    </button>
                  )
                })}
              </div>
            </div>
          )}
        </div>
        <div class="filter__meta">
          <span id="member-count">{stats.current} of {stats.total} members</span>
        </div>
      </div>

      <ul class="grid" id="member-grid">
        {sorted.map((m) => (
          <li
            data-haystack={(m.name + ' ' + (m.affiliation ?? '')).toLowerCase()}
            data-status={[m.is_current ? 'current' : 'past', m.is_in_leadership && 'leadership'].filter(Boolean).join(' ')}
            data-role={memberRoles(m)}
            data-group={memberGroups(m)}
          >
            <a
              href={memberUrl(m)}
              class:list={["card", { 'card--deceased': m.deceased, 'card--chair': m.is_the_chair }]}
            >
              <div class="card__avatar">
                {pictureUrl(m) ? (
                  <img src={pictureUrl(m)} alt={m.name} loading="lazy" />
                ) : (
                  <span>{initials(m.name)}</span>
                )}
              </div>
              <div class="card__body">
                <h3 class="card__name">{m.name}</h3>
                {m.affiliation && <p class="card__affiliation">{m.affiliation}</p>}
                <div class="card__tags">
                  {m.is_the_chair ? (
                    <span class="tag tag--chair">Chair</span>
                  ) : m.is_in_leadership && (
                    <span class="tag tag--leadership">Leadership</span>
                  )}
                  {m.deceased ? (
                    <span class="tag tag--deceased">In Memoriam</span>
                  ) : !m.is_current && (
                    <span class="tag tag--past">Past</span>
                  )}
                  {primaryRoleLabel(m) && <span class="tag">{primaryRoleLabel(m)}</span>}
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <div class="empty" id="member-empty" hidden>
        <h3>No members match your filters</h3>
        <button type="button" class="chip" id="member-clear">Clear filters</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { mountListFilter } from '../lib/list-filter'
  mountListFilter({
    searchInput: '#member-search',
    items: '#member-grid > li',
    facetWrappers: '.filter__chips[data-facet]',
    count: '#member-count',
    countLabel: 'members',
    empty: '#member-empty',
    clear: '#member-clear',
    initialFromUrl: true,
  })
</script>

<style>
  .filter {
    background: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: 0.75rem;
    padding: 1.25rem;
    margin-bottom: 2rem;
  }
  :global(.dark) .filter { background: rgb(15 23 42 / 0.5); border-color: var(--color-slate-700); }
  .filter__search-wrap { position: relative; margin-bottom: 1rem; }
  .filter__search-icon {
    position: absolute; left: 0.75rem; top: 50%;
    transform: translateY(-50%);
    color: var(--color-slate-400);
    pointer-events: none;
  }
  .filter__search {
    width: 100%;
    padding: 0.625rem 0.875rem 0.625rem 2.25rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-slate-300);
    background: var(--color-slate-50);
    color: var(--color-slate-900);
    font-size: 0.9375rem;
    font-family: inherit;
  }
  .filter__search:focus {
    outline: none;
    border-color: var(--color-blue-accent);
    background: var(--color-white);
    box-shadow: 0 0 0 3px rgb(30 58 138 / 0.15);
  }
  :global(.dark) .filter__search { background: var(--color-slate-800); border-color: var(--color-slate-600); color: var(--color-slate-50); }
  :global(.dark) .filter__search:focus { border-color: var(--color-blue-steel); background: var(--color-slate-900); }
  .filter__controls { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: flex-end; }
  .filter__field { display: flex; flex-direction: column; gap: 0.5rem; }
  .filter__label {
    font-size: 0.75rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--color-slate-500);
  }
  :global(.dark) .filter__label { color: var(--color-slate-400); }
  .chip {
    display: inline-flex; align-items: center;
    padding: 0.375rem 0.75rem; border-radius: 9999px;
    border: 1px solid var(--color-slate-300); background: var(--color-white); color: var(--color-slate-600);
    font-size: 0.8125rem; font-weight: 500; font-family: inherit;
    cursor: pointer; transition: all 0.15s; text-transform: capitalize;
  }

  /* Group chips carry a lifecycle dot: filled = current group,
     hollow = inactive/dissolved. Historical chips recede (dashed
     border, muted text) so the current groups read first. */
  .chip__gdot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--color-brand);
    flex-shrink: 0;
  }
  :global(.dark) .chip__gdot { background: var(--color-blue-accent); }
  .chip__gdot--off {
    background: transparent;
    border: 1.5px solid var(--color-slate-400);
  }
  :global(.dark) .chip__gdot--off { border-color: var(--color-slate-400); }

  .chip--historical {
    border-style: dashed;
    border-color: var(--color-slate-300);
    color: var(--color-slate-500);
  }
  .chip--historical:hover {
    border-color: var(--color-blue-accent);
    color: var(--color-blue-accent);
  }
  :global(.dark) .chip--historical {
    border-color: var(--color-slate-700);
    color: var(--color-slate-400);
  }

  .filter__hint {
    display: flex;
    align-items: center;
    gap: 0.3125rem;
    font-size: 0.6875rem;
    color: var(--color-slate-500);
    margin: 0.125rem 0 0.375rem;
  }
  :global(.dark) .filter__hint { color: var(--color-slate-400); }
  .filter__meta { margin-top: 1rem; font-size: 0.875rem; color: var(--color-slate-500); }
  :global(.dark) .filter__meta { color: var(--color-slate-400); }

  .loading, .empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--color-slate-500);
  }
  .empty h3 { color: var(--color-slate-900); margin: 0 0 0.75rem; }
  :global(.dark) .empty h3 { color: var(--color-slate-50); }
  :global(.dark) .loading, :global(.dark) .empty { color: var(--color-slate-400); }

  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }

  .card {
    display: flex; gap: 1rem;
    padding: 1rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-slate-200);
    background: var(--color-white);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
    height: 100%;
  }
  :global(.dark) .card { background: rgb(15 23 42 / 0.5); border-color: var(--color-slate-700); }
  .card:hover {
    border-color: var(--color-blue-accent);
    box-shadow: 0 4px 12px rgb(30 58 138 / 0.08);
    transform: translateY(-2px);
  }
  :global(.dark) .card:hover { border-color: var(--color-blue-steel); box-shadow: 0 4px 12px rgb(0 0 0 / 0.25); }
  .card--chair {
    border-color: var(--color-brand);
  }
  :global(.dark) .card--chair { border-color: var(--color-brand); }
  .card--deceased { opacity: 0.85; }

  .card__avatar {
    width: 3.5rem; height: 3.5rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, var(--color-blue-accent), var(--color-blue-steel));
    color: var(--color-white);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1rem;
    overflow: hidden;
    flex-shrink: 0;
  }
  .card__avatar img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .card--deceased .card__avatar img { filter: grayscale(1); }
  .card__body { flex: 1; min-width: 0; }
  .card__name {
    font-size: 1rem; font-weight: 600; color: var(--color-slate-900);
    margin: 0 0 0.125rem;
  }
  :global(.dark) .card__name { color: var(--color-slate-50); }
  .card__affiliation {
    font-size: 0.8125rem; color: var(--color-slate-500);
    margin: 0 0 0.5rem;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  :global(.dark) .card__affiliation { color: var(--color-slate-400); }
  .card__tags {
    display: flex; flex-wrap: wrap; gap: 0.25rem;
  }
  .tag {
    display: inline-block;
    padding: 0.0625rem 0.5rem;
    font-size: 0.6875rem; font-weight: 600;
    text-transform: capitalize;
    border-radius: 0.25rem;
    background: var(--color-wash); color: var(--color-slate-600);
  }
  :global(.dark) .tag { background: var(--color-slate-800); color: var(--color-slate-300); }
  .tag--chair { background: var(--color-brand-fill); color: var(--color-white); }
  .tag--leadership { background: var(--color-status-warn-bg); color: var(--color-status-warn-text); }
  :global(.dark) .tag--leadership { background: rgb(245 158 11 / 0.2); color: var(--color-status-warn-line); }
  .tag--deceased { background: var(--color-slate-200); color: var(--color-slate-600); font-style: italic; text-transform: none; }
  :global(.dark) .tag--deceased { background: var(--color-slate-700); color: var(--color-slate-400); }
  .tag--past { background: var(--color-wash); color: var(--color-slate-400); text-transform: capitalize; }
  :global(.dark) .tag--past { background: var(--color-slate-800); color: var(--color-slate-500); }
</style>
