  transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s;
  position: relative;
  overflow: hidden;
}
.reg-cta::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgb(16 185 129 / 0.06), transparent 60%);
  pointer-events: none;
}
.reg-cta:hover {
