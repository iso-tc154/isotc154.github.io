---
import fs from 'node:fs'
import yaml from 'js-yaml'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import OrgLogo from '../../components/OrgLogo.astro'
import ScheduleCalendar from '../../components/ScheduleCalendar.astro'
import AgendaDrawers from '../../components/AgendaDrawers.astro'
import { loadData, type Meeting, type MeetingHost } from '../../lib/data'
import {
  practicalLabel, touristItems,
  isSection, isStringList, isUrl, isEmail, practicalEntries, sectionEntries, rateLabel,
  sessionLabel, sessionLocation, sessionVirtual,
  associateRoleLabel, venueMapUrl, venueEmbedSrc, agendaDrawers,
} from '../../lib/meeting'
import { resolutionCards, type EdoxenDecisionDoc, type ResolutionCard } from '../../lib/edoxen-doc'
import { ordinalText, flagEmoji, formatDateCompact, formatDateLong } from '../../lib/presentation'
import { committee } from '../../data/committee'

export function getStaticPaths() {
  return loadData.meetings().map((m) => ({ params: { id: String(m.ordinal) }, props: { ordinal: m.ordinal } }))
}

const allMeetings = loadData.meetings()

const { ordinal } = Astro.props as { ordinal: number }
const meeting = allMeetings.find((m) => m.ordinal === ordinal)
if (!meeting) throw new Error(`Meeting ${ordinal} not found`)

const rich = meeting.rich
const upcoming = meeting.status_label !== 'Concluded' && meeting.status_label !== 'Cancelled'

const venueFlag = flagEmoji(rich?.country_code)

const resolvedHosts: MeetingHost[] = Array.isArray(rich?.hosts) && rich.hosts.length
  ? rich.hosts
  : rich?.host
    ? [{ name: rich.host, kind: 'unknown' }]
    : []
const resolvedAssociates = rich?.associates ?? []

const agendaSessions = agendaDrawers(rich?.agenda)
const agendaClickableDates = agendaSessions.map((s) => s.date).filter(Boolean)
const agendaSourceDoc = rich?.agenda?.source_doc ?? ''
const agendaDraftDate = (() => {
  const m = (agendaSourceDoc.match(/\d{4}-\d{2}-\d{2}/) || [])[0]
  return m ?? null
})()
// ── Resolutions: read the staged edoxen YAML for this plenary ──
let meetingResolutions: ResolutionCard[] = []
try {
  const yamlPath = `_data/resolutions-edoxen/plenary-${ordinal}.yaml`
  if (fs.existsSync(yamlPath)) {
    meetingResolutions = resolutionCards(yaml.load(fs.readFileSync(yamlPath, 'utf8')) as EdoxenDecisionDoc)
  }
} catch { /* resolutions are optional */ }
// ── Prev/next by ordinal ──
const sorted = [...allMeetings].sort((a, b) => (a.ordinal ?? 0) - (b.ordinal ?? 0))
const idx = sorted.findIndex((m) => m.ordinal === ordinal)
const prevMeeting = idx > 0 ? sorted[idx - 1] : null
const nextMeeting = idx >= 0 && idx < sorted.length - 1 ? sorted[idx + 1] : null
function navCaption(m: Meeting): string {
  return [m.rich?.general_area || m.location_label || '', m.year ? String(m.year) : ''].filter(Boolean).join(' · ')
}

const registrationUrl = rich?.registration_url ?? null
const mapUrl = venueMapUrl(rich?.venues?.[0])

---

<BaseLayout title={`${ordinalText(ordinal)} Plenary Meeting — ISO/TC 154`} description={rich?.general_area || meeting.location_label || `The ${ordinalText(ordinal)} plenary meeting of ISO/TC 154.`}>
  <article class="md">
    <PageHero
      variant="detail"
      bleed
      eyebrow={`${ordinalText(meeting.ordinal)} plenary · ${meeting.year ?? '—'}${venueFlag ? ' ' + venueFlag : ''}`}
      title="Plenary Meeting"
      lead={rich?.general_area || meeting.location_label || `A plenary of ${committee.name}.`}
    >
      <div class="md-hero" slot="decoration" aria-hidden="true"></div>
      <div class="md-hero md-hero--grid" slot="decoration" aria-hidden="true"></div>
      <a href="/meetings/" slot="breadcrumb">Plenary Index</a>

      <dl class="md-hero__stats" slot="default">
        {meeting.date_label && (
          <div class="md-hero__stat">
            <dt>Dates</dt>
            <dd>{meeting.date_label}</dd>
          </div>
        )}
        {(rich?.general_area || meeting.primary.country) && (
          <div class="md-hero__stat">
            <dt>Location</dt>
            <dd>{rich?.general_area || meeting.primary.country}</dd>
          </div>
        )}
        {rich?.host && (
          <div class="md-hero__stat">
            <dt>Host</dt>
            <dd>{rich.host}</dd>
          </div>
        )}
        <div class="md-hero__stat">
          <dt>Format</dt>
          <dd>{meeting.type_label}</dd>
        </div>
      </dl>

      {(!registrationUrl || meeting.participant_total || (meeting.resolution_count ?? 0) > 0 || meetingResolutions.length > 0) && (
        <div class="md-hero__badges" slot="default">
          {meeting.status_label === 'Cancelled' ? (
            <span class="pill pill--cancelled">Cancelled</span>
          ) : upcoming && !registrationUrl ? (
            <span class="pill pill--upcoming">Upcoming</span>
          ) : !upcoming && (
            <span class="pill pill--concluded">Concluded</span>
          )}
          {meeting.participant_total && <span class="pill pill--meta">{meeting.participant_total} participants</span>}
          {(meetingResolutions.length > 0) && (
            <span class="pill pill--res">{meetingResolutions.length} resolution{meetingResolutions.length === 1 ? '' : 's'}</span>
          )}
        </div>
      )}

      {registrationUrl && upcoming && (
        <a href={registrationUrl} target="_blank" rel="noopener noreferrer" class="reg-cta" slot="actions">
          <span class="reg-cta__status">
            <span class="reg-cta__pulse" aria-hidden="true"></span>
            Registration open
          </span>
          <span class="reg-cta__action">
            <span class="reg-cta__verb">Register</span>
            <span class="reg-cta__arrow" aria-hidden="true">→</span>
          </span>
        </a>
      )}
    </PageHero>

    <div class="md__nav">
      <nav class="pnn pnn--center" aria-label="Pagination">
        <div class="pnn__rail">
          <span class="pnn__rail-rule" aria-hidden="true"></span>
          <span class="pnn__rail-label">Other plenary meetings</span>
        </div>
        <div class="pnn__grid">
          {prevMeeting ? (
            <a href={`/meetings/${prevMeeting.ordinal}/`} class="pnn__cell pnn__cell--prev" rel="prev">
              <span class="pnn__arrow pnn__arrow--prev" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5" /><path d="M12 5l-7 7 7 7" /></svg>
              </span>
              <span class="pnn__body">
                <span class="pnn__hint">Previous</span>
                <span class="pnn__numeral">{prevMeeting.ordinal}</span>
                <span class="pnn__label">{ordinalText(prevMeeting.ordinal)}</span>
                <span class="pnn__caption">{navCaption(prevMeeting)}</span>
              </span>
            </a>
          ) : (
            <span class="pnn__cell pnn__cell--muted" aria-hidden="true">
              <span class="pnn__arrow pnn__arrow--prev pnn__arrow--silent" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5" /><path d="M12 5l-7 7 7 7" /></svg>
              </span>
              <span class="pnn__body"><span class="pnn__hint pnn__hint--silent">Beginning</span></span>
            </span>
          )}
          <span class="pnn__divider" aria-hidden="true"></span>
          {nextMeeting ? (
            <a href={`/meetings/${nextMeeting.ordinal}/`} class="pnn__cell pnn__cell--next" rel="next">
              <span class="pnn__body">
                <span class="pnn__hint">Next</span>
                <span class="pnn__numeral">{nextMeeting.ordinal}</span>
                <span class="pnn__label">{ordinalText(nextMeeting.ordinal)}</span>
                <span class="pnn__caption">{navCaption(nextMeeting)}</span>
              </span>
              <span class="pnn__arrow pnn__arrow--next" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5l7 7-7 7" /></svg>
              </span>
            </a>
          ) : (
            <span class="pnn__cell pnn__cell--muted" aria-hidden="true">
              <span class="pnn__body"><span class="pnn__hint pnn__hint--silent">Latest</span></span>
              <span class="pnn__arrow pnn__arrow--next pnn__arrow--silent" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5l7 7-7 7" /></svg>
              </span>
            </span>
          )}
        </div>
      </nav>
    </div>

    <div class="md__body">
      <nav class="md__quick-links" aria-label="Meeting actions">
        {meeting.primary.iso_meeting_url && (
          <a href={meeting.primary.iso_meeting_url} target="_blank" rel="noopener noreferrer" class="quick-link">
            ISO committee meeting <span aria-hidden="true">↗</span>
          </a>
        )}
        {meetingResolutions.length > 0 && (
          <div class="urn-bar">
            <span class="urn-bar__label">{meetingResolutions.length} resolution{meetingResolutions.length === 1 ? '' : 's'}</span>
          </div>
        )}
      </nav>

      {meeting.primary.cancellation_comment && (
        <section class="alert alert--cancelled">
          <h3 class="alert__title">This meeting was cancelled</h3>
          <p class="alert__body">{meeting.primary.cancellation_comment}</p>
        </section>
      )}

      {meeting.primary.reschedule_note && (
        <section class="alert alert--reschedule">
          <h3 class="alert__title">Rescheduled</h3>
          <p class="alert__body">
            {meeting.primary.reschedule_note}
            {meeting.primary.reschedule_timeframe && <> ({meeting.primary.reschedule_timeframe})</>}
          </p>
        </section>
      )}

      {rich?.venues?.length ? (
        <section class="block">
          <h2 class="block__title">Venue</h2>
          {rich.venues.map((v) => (
            <div class="venue-layout">
              <div class="venue-card venue-card--stacked">
                <div class="venue-card__main">
                  {v.name && <p class="venue-card__name">{v.name}</p>}
                  {v.address && <pre class="venue-card__address">{v.address}</pre>}
                  {v.note && <p class="venue-card__note">{v.note}</p>}
                  <div class="venue-card__links">
                    {v.link && <a href={v.link} target="_blank" rel="noopener noreferrer">Venue website →</a>}
                    {mapUrl && <a href={mapUrl} target="_blank" rel="noopener noreferrer">OpenStreetMap →</a>}
                  </div>
                </div>
              </div>
              {venueEmbedSrc(v) && (
                <div class="venue-map">
                  <iframe
                    src={venueEmbedSrc(v)!}
                    title={`Map showing ${v.name ?? 'meeting venue'}`}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                  ></iframe>
                  <small class="venue-map__credit">
                    Map data &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors
                  </small>
                </div>
              )}
            </div>
          ))}
        </section>
      ) : (rich?.general_area || meeting.location_label) && (
        <section class="block">
          <h2 class="block__title">Location</h2>
          <p class="block__scalar">{rich?.general_area || meeting.location_label}</p>
        </section>
      )}

      {(resolvedHosts.length > 0 || rich?.host) && (
        <section class="block">
          <h2 class="block__title">Hosted by</h2>
          <div class="host-grid">
            {resolvedHosts.map((h) => (
              <a class:list={["host-card", { 'host-card--linkable': !!h.path }]} href={h.path || undefined}>
                {(h.logo || h.logo_light || h.logo_dark) ? (
                  <OrgLogo logo={h.logo} logo_light={h.logo_light} logo_dark={h.logo_dark} size="md" radius="0.375rem" fallbackText={h.short_name ?? h.name} alt={h.name} />
                ) : (
                  <div class="host-card__monogram" aria-hidden="true">{(h.name || '?').slice(0, 2).toUpperCase()}</div>
                )}
                <div class="host-card__meta">
                  <p class="host-card__name">{h.name}</p>
                  {h.kind === 'liaison' && <p class="host-card__kind">Liaison organization</p>}
                  {h.kind === 'national-body' && <p class="host-card__kind">National body</p>}
                  {h.contact?.name && (
                    <p class="host-card__contact">
                      <span class="host-card__contact-name">{h.contact.name}</span>
                      {h.contact.title && <span class="host-card__contact-title">{h.contact.title}</span>}
                    </p>
                  )}
                  {h.path && <p class="host-card__link">View profile <span aria-hidden="true">→</span></p>}
                  {!h.path && h.url && (
                    <a href={h.url} target="_blank" rel="noopener noreferrer" class="host-card__link">
                      Visit website <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </a>
            ))}
            {resolvedHosts.length === 0 && rich?.host && <p class="host-grid__plain">{rich.host}</p>}
          </div>
        </section>
      )}

      {resolvedAssociates.length > 0 && (
        <section class="block">
          <h2 class="block__title">In association with</h2>
          <ul class="assoc-list">
            {resolvedAssociates.map((a) => (
              <li class:list={[`assoc assoc--${a.kind}`, { 'assoc--linkable': !!(a.path || a.url) }]}>
                <a class="assoc__main" href={a.path || a.url || undefined} target={a.url && !a.path ? '_blank' : undefined} rel={a.url && !a.path ? 'noopener noreferrer' : undefined}>
                  {(a.logo || a.logo_light || a.logo_dark) ? (
                    <OrgLogo logo={a.logo} logo_light={a.logo_light} logo_dark={a.logo_dark} size="sm" radius="0.3125rem" fallbackText={a.short_name ?? a.name} alt={a.name} />
                  ) : (
                    <div class="assoc__monogram" aria-hidden="true">{(a.name || '?').slice(0, 2).toUpperCase()}</div>
                  )}
                  <div class="assoc__text">
                    <div class="assoc__name-row">
                      <span class="assoc__name">{a.name}</span>
                      {a.role && <span class="assoc__role">{associateRoleLabel(a.role)}</span>}
                    </div>
                    {a.kind === 'liaison' && <p class="assoc__kind">Liaison organization</p>}
                    {a.kind === 'national-body' && <p class="assoc__kind">National body</p>}
                    {a.kind !== 'liaison' && a.kind !== 'national-body' && a.country && <p class="assoc__kind">{a.country}</p>}
                    {a.contact?.name && (
                      <p class="assoc__contact">
                        <span class="assoc__contact-name">{a.contact.name}</span>
                        {a.contact.title && <span class="assoc__contact-title"> · {a.contact.title}</span>}
                      </p>
                    )}
                    {a.path && <p class="assoc__link">View profile <span aria-hidden="true">→</span></p>}
                    {!a.path && a.url && <p class="assoc__link">Visit website <span aria-hidden="true">↗</span></p>}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {rich?.secretariat && (rich.secretariat.name || rich.secretariat.organization || rich.secretariat.email) && (
        <section class="block">
          <h2 class="block__title">Secretariat</h2>
          <div class="secretary-card">
            {rich.secretariat.name && <p class="secretary-card__name">{rich.secretariat.name}</p>}
            {rich.secretariat.organization && <p class="secretary-card__org">{rich.secretariat.organization}</p>}
            {rich.secretariat.email && (
              <p class="secretary-card__contact"><a href={`mailto:${rich.secretariat.email}`}>{rich.secretariat.email}</a></p>
            )}
            {rich.secretariat.phone && <p class="secretary-card__contact">{rich.secretariat.phone}</p>}
          </div>
        </section>
      )}

      {(rich?.schedule?.length ?? 0) > 0 && (
        <section class="block">
          <h2 class="block__title">Daily schedule</h2>
          <ScheduleCalendar
            schedule={rich!.schedule}
            venueName={rich?.venues?.[0]?.name}
            generalArea={rich?.general_area}
            agendaDates={agendaClickableDates}
          />
        </section>
      )}

      {rich?.accommodation_options?.length ? (
        <section class="block">
          <h2 class="block__title">Accommodation</h2>
          <ul class="list-card">
            {rich.accommodation_options.map((a) => (
              <li class="list-card__item list-card__item--rich">
                <div class="list-card__head">
                  {a.link ? (
                    <a href={a.link} target="_blank" rel="noopener noreferrer" class="list-card__name">{a.name}</a>
                  ) : (
                    <span class="list-card__name">{a.name}</span>
                  )}
                  {a.distance && <span class="list-card__chip">{a.distance}</span>}
                  {a.code && <span class="list-card__chip list-card__chip--code">Booking code: {a.code}</span>}
                </div>
                {a.address && <p class="list-card__meta">{a.address}</p>}
                {a.email && <p class="list-card__meta"><a href={`mailto:${a.email}`}>{a.email}</a></p>}
                {a.rates && Object.keys(a.rates).length > 0 ? (
                  <dl class="list-card__rates">
                    {Object.entries(a.rates).map(([k, v]) => (
                      <><dt>{rateLabel(k)}</dt><dd>{v}</dd></>
                    ))}
                  </dl>
                ) : a.price && <p class="list-card__meta">{a.price}</p>}
                {a.breakfast && <p class="list-card__meta list-card__meta--soft">Breakfast: {a.breakfast}</p>}
                {a.notes && <p class="list-card__notes">{a.notes}</p>}
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      {rich?.practical_info && practicalEntries(rich.practical_info).length > 0 && (
        <section class="block">
          <h2 class="block__title">Practical information</h2>
          <div class="practical">
            {practicalEntries(rich.practical_info).map(([key, value]) => (
              <div class="practical__entry">
                <p class="practical__label">{practicalLabel(key)}</p>
                {isSection(value) ? (
                  <div class="practical__section">
                    <dl class="practical__dl">
                      {sectionEntries(value).map(([subKey, subVal]) => (
                        <>
                          <dt class="practical__dt">{practicalLabel(subKey)}</dt>
                          <dd class="practical__dd">
                            {typeof subVal === 'boolean' ? (subVal ? 'Yes' : 'No') : (
                              isUrl(subVal) ? <a href={subVal} target="_blank" rel="noopener noreferrer">{subVal}</a>
                              : isEmail(subVal) ? <a href={`mailto:${subVal}`}>{subVal}</a>
                              : isStringList(subVal) ? (
                                <ul class="practical__list">
                                  {subVal.map((item) => <li>{item}</li>)}
                                </ul>
                              ) : <span>{String(subVal)}</span>
                            )}
                          </dd>
                        </>
                      ))}
                    </dl>
                  </div>
                ) : isStringList(value) ? (
                  <ul class="practical__list practical__list--top">
                    {value.map((item) => <li>{item}</li>)}
                  </ul>
                ) : (
                  <p class="practical__scalar">
                    {isUrl(value) ? <a href={value} target="_blank" rel="noopener noreferrer">{value}</a> : <span>{String(value)}</span>}
                  </p>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      {rich?.lunch_recommendations?.length ? (
        <section class="block">
          <h2 class="block__title">Lunch recommendations</h2>
          <ul class="list-card">
            {rich.lunch_recommendations.map((l) => (
              <li class="list-card__item">
                {(l.link || l.url) ? (
                  <a href={l.link || l.url} target="_blank" rel="noopener noreferrer" class="list-card__name">{l.name}</a>
                ) : (
                  <span class="list-card__name">{l.name}</span>
                )}
                {l.address && <p class="list-card__meta">{l.address}</p>}
                {l.notes && <p class="list-card__notes">{l.notes}</p>}
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      {rich?.biergartens?.length ? (
        <section class="block">
          <h2 class="block__title">Biergartens &amp; evenings</h2>
          <ul class="list-card">
            {rich.biergartens.map((b) => (
              <li class="list-card__item list-card__item--rich">
                <div class="list-card__head">
                  {(b.link || b.url) ? (
                    <a href={b.link || b.url} target="_blank" rel="noopener noreferrer" class="list-card__name">{b.name}</a>
                  ) : (
                    <span class="list-card__name">{b.name}</span>
                  )}
                  {b.walk_minutes && <span class="list-card__chip">{b.walk_minutes} min walk</span>}
                </div>
                {b.address && <p class="list-card__meta">{b.address}</p>}
                {b.style && <p class="list-card__meta list-card__meta--soft">{b.style}</p>}
                {b.notes && <p class="list-card__notes">{b.notes}</p>}
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      {touristItems(rich?.tourist_info).length > 0 && (
        <section class="block">
          <h2 class="block__title">Things to see</h2>
          <div class="practical">
            {touristItems(rich.tourist_info).map((t) => (
              <div class="practical__entry tourist__entry">
                {t.link ? (
                  <a href={t.link} target="_blank" rel="noopener noreferrer" class="tourist__name">{t.name} <span aria-hidden="true">↗</span></a>
                ) : (
                  <p class="tourist__name tourist__name--plain">{t.name}</p>
                )}
                {t.notes && <p class="tourist__notes">{t.notes}</p>}
              </div>
            ))}
          </div>
        </section>
      )}

      {rich?.deadlines?.length ? (
        <section class="block">
          <h2 class="block__title">Key dates &amp; deadlines</h2>
          <ul class="deadlines">
            {rich.deadlines.map((d) => (
              <li class="deadlines__item">
                {d.date && <span class="deadlines__date">{formatDateCompact(d.date)}</span>}
                <div>
                  {d.label && <p class="deadlines__label">{d.label}</p>}
                  {d.description && <p class="deadlines__desc">{d.description}</p>}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      {meeting.sessions.length > 1 && (
        <section class="block">
          <h2 class="block__title">All sessions ({meeting.sessions.length})</h2>
          <ul class="sessions">
            {meeting.sessions.map((s) => (
              <li class="sessions__item">
                <div class="sessions__meta">
                  <span class="sessions__type">{s.type === 'hybrid' ? 'Hybrid' : s.type === 'virtual' ? 'Virtual' : 'In person'}</span>
                  {s.iso_meeting_url ? (
                    <a href={s.iso_meeting_url} target="_blank" rel="noopener noreferrer" class="sessions__link">ISO #{s.iso_meeting_id} ↗</a>
                  ) : s.iso_meeting_id ? (
                    <span class="sessions__link sessions__link--plain">ISO #{s.iso_meeting_id}</span>
                  ) : null}
                </div>
                {sessionLabel(s) && <p class="sessions__date">{sessionLabel(s)}</p>}
                {sessionLocation(s) && <p class="sessions__loc">{sessionLocation(s)}</p>}
                {sessionVirtual(s) && <p class="sessions__virtual">Online · {sessionVirtual(s)}</p>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {meetingResolutions.length > 0 && (
        <section class="block">
          <h2 class="block__title">
            {meetingResolutions.length} resolution{meetingResolutions.length === 1 ? '' : 's'} adopted
          </h2>
          <p class="block__lead">
            Adopted at the {ordinalText(meeting.ordinal)} plenary of {committee.name}.
          </p>
          <ul class="res-list">
            {meetingResolutions.map((res) => (
              <li>
                <a href={`/decisions/${res.urn}/`} class="res-card">
                  <div class="res-card__head">
                    {res.isAcclamation ? (
                      <span class="res-card__kind res-card__kind--acclamation">Acclamation</span>
                    ) : (
                      <>
                        <span class="res-card__id">{res.id}</span>
                        <span class="res-card__kind">{res.kind === 'resolution' ? 'Plenary' : res.kind}</span>
                      </>
                    )}
                  </div>
                  <p class="res-card__title">{res.isAcclamation ? 'Acclamation' : (res.title || `Resolution ${res.id}`)}</p>
                  {res.subject && <span class="res-card__subject">{res.subject}</span>}
                  <span class="res-card__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <AgendaDrawers sessions={agendaSessions} sourceDoc={agendaSourceDoc} draftDate={agendaDraftDate} />
  </article>
</BaseLayout>

