    {agendaSessions.map((s) => (
      <div class="ad" data-agenda={s.key} hidden>
        <div class="ad__backdrop" data-close-agenda></div>
        <aside class="ad__panel" role="dialog" aria-label={`${s.label} agenda`} aria-modal="true">
          <header class="ad__header">
            <div class="ad__title-block">
              <p class="ad__eyebrow">{s.label}</p>
              <h3 class="ad__date">{formatDateLong(s.date)}</h3>
              {agendaDraftDate && <p class="ad__draft">Draft of {agendaDraftDate}</p>}
            </div>
            <button class="ad__close" data-close-agenda aria-label="Close agenda">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </header>
          {s.note && <p class="ad__note">{s.note}</p>}
          <div class="ad__body">
            <div class="ad__table-wrap">
              <table class="ad__table">
                <thead>
                  <tr>
                    <th scope="col" class="ad__th ad__th--seq">Seq</th>
                    <th scope="col" class="ad__th ad__th--title">Title</th>
                    <th scope="col" class="ad__th ad__th--resp">Responsible</th>
                    <th scope="col" class="ad__th ad__th--ref">Ref.</th>
                  </tr>
                </thead>
                <tbody>
                  {s.rows.map((row) => (
                    <tr class:list={{ 'ad__tr--sub': row.depth > 0 }}>
                      <td class="ad__td ad__td--seq">{row.seq}</td>
                      <td class="ad__td ad__td--title" style={`padding-left:${0.5 + row.depth * 1.125}rem`}>{row.title}</td>
                      <td class="ad__td ad__td--resp">{row.responsible}</td>
                      <td class="ad__td ad__td--ref">{row.ref}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          {agendaSourceDoc && <footer class="ad__footer">Source: {agendaSourceDoc}</footer>}
        </aside>
      </div>
    ))}
    <script is:inline type="application/json" id="agenda-dates" set:html={JSON.stringify(Object.fromEntries(agendaSessions.map((s) => [s.key, s.date])))} />
  </article>
</BaseLayout>

<script>
  // Agenda drawer: clicking a clickable calendar event opens the drawer whose
  // session date matches; Escape/backdrop/button close it.
  const drawers = Array.from(document.querySelectorAll<HTMLElement>('[data-agenda]'))
  const dateToKey = new Map<string, string>()
  const KEY_DATES: Record<string, string> = JSON.parse(document.getElementById('agenda-dates')?.textContent || '{}')
  for (const [key, date] of Object.entries(KEY_DATES)) dateToKey.set(date, key)

  function open(key: string) {
    drawers.forEach((d) => { d.hidden = d.dataset.agenda !== key })
    document.body.style.overflow = 'hidden'
  }
  function close() {
    drawers.forEach((d) => { d.hidden = true })
    document.body.style.overflow = ''
  }

  document.querySelectorAll<HTMLElement>('[data-agenda-date]').forEach((el) => {
    const handler = (e: Event) => {
      e.preventDefault()
      const key = dateToKey.get(el.dataset.agendaDate || '')
      if (key) open(key)
    }
    el.addEventListener('click', handler)
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter') handler(e) })
  })
  document.querySelectorAll('[data-close-agenda]').forEach((el) => el.addEventListener('click', close))
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape') close() })
</script>

