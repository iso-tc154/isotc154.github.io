---
import fs from 'node:fs'
import yaml from 'js-yaml'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import OrgLogo from '../../components/OrgLogo.astro'
import ScheduleCalendar from '../../components/ScheduleCalendar.astro'
import { loadData } from '../../lib/data'
import { committee } from '../../data/committee'

interface Session {
  type?: string
  country?: string
  city?: string
  virtual_address?: string
  iso_meeting_id?: string | number
  iso_meeting_url?: string
  start_date?: string
  end_date?: string
}
interface Host {
  name: string
  short_name?: string
  kind?: string
  url?: string
  path?: string
  logo?: string
  logo_light?: string
  logo_dark?: string
  country?: string
  contact?: { name?: string; title?: string }
}
interface Associate extends Host { role?: string }
interface Rich {
  general_area?: string
  country_code?: string
  registration_url?: string
  host?: string
  hosts?: Host[]
  associates?: Associate[]
  venues?: { name?: string; address?: string; note?: string; link?: string; lat?: number; lon?: number }[]
  secretariat?: { name?: string; organization?: string; email?: string; phone?: string }
  schedule?: { date?: string; time?: string; event?: string; description?: string }[]
  deadlines?: { date?: string; label?: string; description?: string }[]
  accommodation_options?: { name: string; address?: string; link?: string; email?: string; distance?: string; code?: string; rates?: Record<string, string>; price?: string; breakfast?: string; notes?: string }[]
  practical_info?: Record<string, unknown>
  lunch_recommendations?: { name: string; address?: string; link?: string; url?: string; notes?: string }[]
  biergartens?: { name: string; address?: string; link?: string; url?: string; walk_minutes?: number; style?: string; notes?: string }[]
  tourist_info?: unknown
  agenda?: {
    source_doc?: string
    structure?: string
    opening_session?: AgendaSession
    closing_session?: AgendaSession
    wg_meetings?: { dates?: string; note?: string }
  }
}
interface AgendaItem { number?: number; title: string; speaker?: string; n_doc?: string; subitems?: AgendaItem[] }
interface AgendaSession { date?: string; note?: string; items?: AgendaItem[] }

interface MeetingDoc {
  ordinal: number
  year?: number
  url: string
  sessions: Session[]
  primary: Session & {
    country?: string
    city?: string
    reschedule_note?: string
    reschedule_timeframe?: string
    cancellation_comment?: string
    iso_meeting_url?: string
  }
  status_label?: string
  type_label?: string
  location_label?: string
  date_label?: string
  participant_total?: number
  resolution_count?: number
  rich?: Rich
}

export function getStaticPaths() {
  const allMeetings = loadData.meetings() as unknown as MeetingDoc[]
  return allMeetings.map((m) => ({ params: { id: String(m.ordinal) }, props: { ordinal: m.ordinal } }))
}

const allMeetings = loadData.meetings() as unknown as MeetingDoc[]

const { ordinal } = Astro.props as { ordinal: number }
const meeting = allMeetings.find((m) => m.ordinal === ordinal) as MeetingDoc | undefined
if (!meeting) throw new Error(`Meeting ${ordinal} not found`)

const rich = meeting.rich
const upcoming = meeting.status_label !== 'Concluded' && meeting.status_label !== 'Cancelled'

function ordinalSuffix(n: number): string {
  if (n >= 11 && n <= 13) return 'th'
  switch (n % 10) {
    case 1: return 'st'
    case 2: return 'nd'
    case 3: return 'rd'
    default: return 'th'
  }
}
const ordinalText = (n: number) => `${n}${ordinalSuffix(n)}`

function countryCodeToFlag(code?: string | null): string {
  if (!code) return ''
  const trimmed = code.trim().toUpperCase()
  if (!/^[A-Z]{2}$/.test(trimmed)) return ''
  return trimmed.replace(/./g, (c) => String.fromCodePoint(127397 + c.charCodeAt(0)))
}
const venueFlag = countryCodeToFlag(rich?.country_code)

function venueMapUrl(): string | null {
  const v = rich?.venues?.[0]
  if (!v || v.lat == null || v.lon == null) return null
  return `https://www.openstreetmap.org/?mlat=${v.lat}&mlon=${v.lon}#map=16/${v.lat}/${v.lon}`
}
function venueEmbedSrc(v: { lat?: number; lon?: number } | undefined): string | null {
  if (!v || v.lat == null || v.lon == null) return null
  const d = 0.008
  return `https://www.openstreetmap.org/export/embed.html?bbox=${(v.lon - d).toFixed(6)}%2C${(v.lat - d).toFixed(6)}%2C${(v.lon + d).toFixed(6)}%2C${(v.lat + d).toFixed(6)}&layer=mapnik&marker=${v.lat}%2C${v.lon}`
}

const resolvedHosts: Host[] = Array.isArray(rich?.hosts) && rich.hosts.length
  ? rich.hosts
  : rich?.host
    ? [{ name: rich.host, kind: 'unknown' }]
    : []
const resolvedAssociates = rich?.associates ?? []

function rateLabel(key: string): string {
  return key.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
}

const LABEL_OVERRIDES: Record<string, string> = {
  eu_schengen: 'EU Schengen',
  info_url: 'Information URL',
  invitation_contact: 'Invitation Contact',
  invitation_email: 'Invitation email',
  required_info: 'Required information',
  badge_required: 'Badge required',
  badge_info: 'Badge',
  wifi: 'Wi-Fi',
  smoking: 'Smoking',
  electrical: 'Electrical',
  url: 'URL',
  museums_url: 'Museums URL',
  ifa_note: 'IFA note',
  ifa_url: 'IFA URL',
}
function practicalLabel(key: string): string {
  if (LABEL_OVERRIDES[key]) return LABEL_OVERRIDES[key]
  return key.replace(/[_-]+/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
}
type PV = string | string[] | Record<string, unknown> | boolean
const isSection = (v: PV): v is Record<string, unknown> => typeof v === 'object' && v !== null && !Array.isArray(v)
const isStringList = (v: PV): v is string[] => Array.isArray(v)
const isUrl = (v: unknown): v is string => typeof v === 'string' && /^https?:\/\//.test(v)
const isEmail = (v: unknown): v is string => typeof v === 'string' && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)
function practicalEntries(info: Record<string, unknown> | undefined): [string, PV][] {
  if (!info) return []
  return Object.entries(info).filter(([, v]) => v != null && v !== '' && !(Array.isArray(v) && v.length === 0)) as [string, PV][]
}
function sectionEntries(section: Record<string, unknown>): [string, PV][] {
  return Object.entries(section).filter(([, v]) => v != null && v !== '' && !(Array.isArray(v) && v.length === 0) && !(typeof v === 'boolean' && v === false)) as [string, PV][]
}
function touristInfoAsSection(value: unknown): Record<string, unknown> {
  if (Array.isArray(value)) {
    const section: Record<string, unknown> = {}
    value.forEach((item: { name?: string; link?: string; notes?: string }, i: number) => {
      section[item.name ?? `Item ${i + 1}`] = { link: item.link, notes: item.notes }
    })
    return section
  }
  return (value ?? {}) as Record<string, unknown>
}

function formatDateCompact(dateStr: string): string {
  const s = String(dateStr)
  const m = s.match(/^(\d{4})-(\d{2})-(\d{2})/)
  if (!m) return s
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
  const monthIdx = parseInt(m[2], 10) - 1
  return `${parseInt(m[3], 10)} ${months[monthIdx]} ${m[1]}`
}
function formatDateLong(value: unknown): string {
  if (!value) return ''
  const iso = String(value)
  const m = iso.match(/^(\d{4})-(\d{2})-(\d{2})/)
  if (!m) return iso
  const d = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]))
  return d.toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
}
function formatSessionDate(raw: string): string {
  const m = raw.match(/^(\d{1,2})\s+([A-Za-z]{3})\s+(\d{4})(?:\s+(\d{1,2}:\d{2})(?:\s+([A-Z]+))?)?$/)
  if (!m) return raw
  return `${m[1]} ${m[2]} ${m[3]}${m[4] ? ` ${m[4]}` : ''}${m[5] && m[5] !== 'UTC' ? ` ${m[5]}` : ''}`
}
function sessionLabel(s: Session): string {
  const parts: string[] = []
  if (s.start_date) parts.push(formatSessionDate(s.start_date))
  if (s.end_date && s.end_date !== s.start_date) parts.push(formatSessionDate(s.end_date))
  return parts.join(' – ')
}
function sessionLocation(s: Session): string {
  const parts: string[] = []
  if (s.city) parts.push(s.city.replace(/[,;]\s*$/, ''))
  if (s.country && s.country !== s.city) parts.push(s.country)
  return parts.join(' · ')
}
function sessionVirtual(s: Session): string | null {
  if (!s.virtual_address) return null
  const v = s.virtual_address.toLowerCase()
  if (v === 'zoom' || v === 'teams' || v === 'online') return null
  return s.virtual_address
}
const ASSOC_ROLE_LABELS: Record<string, string> = {
  'co-organizer': 'Co-organizer',
  'cohost': 'Co-host',
  'co-host': 'Co-host',
}
function associateRoleLabel(role?: string): string {
  if (!role) return ''
  return ASSOC_ROLE_LABELS[role.toLowerCase()] || role.replace(/[_-]+/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
}

// ── Agenda flattening (port of src-legacy/src/domain/agenda.ts) ──
interface FlatRow { seq: string; title: string; responsible: string; ref: string; depth: number }
function parseLeadingSeq(title: string): { seq: string; title: string } {
  const m = title.match(/^(\d+(?:\.\d+)*)\s+(.+)$/)
  return m ? { seq: m[1], title: m[2] } : { seq: '', title }
}
const cleanResponsible = (s?: string) => (s ? s.replace(/_/g, ' ') : '')
function flattenAgenda(items: AgendaItem[] | undefined, depth = 0): FlatRow[] {
  const out: FlatRow[] = []
  if (!items) return out
  for (const item of items) {
    const parsed = parseLeadingSeq(item.title)
    const seq = item.number != null ? String(item.number) : parsed.seq
    const title = item.number != null ? item.title : parsed.title
    out.push({ seq, title, responsible: cleanResponsible(item.speaker), ref: item.n_doc ?? '', depth })
    if (item.subitems?.length) out.push(...flattenAgenda(item.subitems, depth + 1))
  }
  return out
}
function normalizeAgendaDate(raw: unknown): string {
  if (!raw) return ''
  const s = String(raw)
  const m = s.match(/^(\d{4})-(\d{2})-(\d{2})/)
  return m ? `${m[1]}-${m[2]}-${m[3]}` : s
}

const agendaSessions: { key: string; label: string; date: string; note?: string; rows: FlatRow[] }[] = []
if (rich?.agenda?.opening_session) {
  const s = rich.agenda.opening_session
  agendaSessions.push({ key: 'opening', label: 'Opening session', date: normalizeAgendaDate(s.date), note: s.note, rows: flattenAgenda(s.items) })
}
if (rich?.agenda?.closing_session) {
  const s = rich.agenda.closing_session
  agendaSessions.push({ key: 'closing', label: 'Closing session', date: normalizeAgendaDate(s.date), note: s.note, rows: flattenAgenda(s.items) })
}
const agendaClickableDates = agendaSessions.map((s) => s.date).filter(Boolean)
const agendaSourceDoc = rich?.agenda?.source_doc ?? ''
const agendaDraftDate = (() => {
  const m = (agendaSourceDoc.match(/\d{4}-\d{2}-\d{2}/) || [])[0]
  return m ?? null
})()

// ── Resolutions: read the staged edoxen YAML for this plenary ──
interface ResCard { id: string; urn: string; title: string; subject: string; kind: string; isAcclamation: boolean }
let meetingResolutions: ResCard[] = []
try {
  const yamlPath = `_data/resolutions-edoxen/plenary-${ordinal}.yaml`
  if (fs.existsSync(yamlPath)) {
    const doc = yaml.load(fs.readFileSync(yamlPath, 'utf8')) as {
      decisions?: {
        urn: string
        kind?: string
        status?: string
        title?: { value?: string }[]
        subject?: { value?: string }[]
        actions?: { message?: { value?: string }[] }[]
      }[]
    }
    meetingResolutions = (doc.decisions ?? []).map((d) => ({
      id: (d.urn.split(':').pop() ?? d.urn),
      urn: d.urn,
      title: d.title?.[0]?.value ?? '',
      subject: d.subject?.[0]?.value ?? '',
      kind: d.kind ?? 'resolution',
      isAcclamation: d.kind === 'acclamation' || d.status === 'acclaimed',
    }))
  }
} catch { /* resolutions are optional */ }

// ── Prev/next by ordinal ──
const sorted = [...allMeetings].sort((a, b) => a.ordinal - b.ordinal)
const idx = sorted.findIndex((m) => m.ordinal === ordinal)
const prevMeeting = idx > 0 ? sorted[idx - 1] : null
const nextMeeting = idx >= 0 && idx < sorted.length - 1 ? sorted[idx + 1] : null
function navCaption(m: MeetingDoc): string {
  return [m.rich?.general_area || m.location_label || '', m.year ? String(m.year) : ''].filter(Boolean).join(' · ')
}

const registrationUrl = rich?.registration_url ?? null
const mapUrl = venueMapUrl()
---

<BaseLayout title={`${ordinalText(ordinal)} Plenary Meeting — ISO/TC 154`} description={rich?.general_area || meeting.location_label || `The ${ordinalText(ordinal)} plenary meeting of ISO/TC 154.`}>
  <article class="md">
    <PageHero
      variant="detail"
      bleed
      eyebrow={`${ordinalText(meeting.ordinal)} plenary · ${meeting.year ?? '—'}${venueFlag ? ' ' + venueFlag : ''}`}
      title="Plenary Meeting"
      lead={rich?.general_area || meeting.location_label || `A plenary of ${committee.name}.`}
    >
      <div class="md-hero" slot="decoration" aria-hidden="true"></div>
      <div class="md-hero md-hero--grid" slot="decoration" aria-hidden="true"></div>
      <a href="/meetings/" slot="breadcrumb">Plenary Index</a>

      <dl class="md-hero__stats" slot="default">
        {meeting.date_label && (
          <div class="md-hero__stat">
            <dt>Dates</dt>
            <dd>{meeting.date_label}</dd>
          </div>
        )}
        {(rich?.general_area || meeting.primary.country) && (
          <div class="md-hero__stat">
            <dt>Location</dt>
            <dd>{rich?.general_area || meeting.primary.country}</dd>
          </div>
        )}
        {rich?.host && (
          <div class="md-hero__stat">
            <dt>Host</dt>
            <dd>{rich.host}</dd>
          </div>
        )}
        <div class="md-hero__stat">
          <dt>Format</dt>
          <dd>{meeting.type_label}</dd>
        </div>
      </dl>

      {(!registrationUrl || meeting.participant_total || (meeting.resolution_count ?? 0) > 0 || meetingResolutions.length > 0) && (
        <div class="md-hero__badges" slot="default">
          {meeting.status_label === 'Cancelled' ? (
            <span class="pill pill--cancelled">Cancelled</span>
          ) : upcoming && !registrationUrl ? (
            <span class="pill pill--upcoming">Upcoming</span>
          ) : !upcoming && (
            <span class="pill pill--concluded">Concluded</span>
          )}
          {meeting.participant_total && <span class="pill pill--meta">{meeting.participant_total} participants</span>}
          {(meetingResolutions.length > 0) && (
            <span class="pill pill--res">{meetingResolutions.length} resolution{meetingResolutions.length === 1 ? '' : 's'}</span>
          )}
        </div>
      )}

      {registrationUrl && upcoming && (
        <a href={registrationUrl} target="_blank" rel="noopener noreferrer" class="reg-cta" slot="actions">
          <span class="reg-cta__status">
            <span class="reg-cta__pulse" aria-hidden="true"></span>
            Registration open
          </span>
          <span class="reg-cta__action">
            <span class="reg-cta__verb">Register</span>
            <span class="reg-cta__arrow" aria-hidden="true">→</span>
          </span>
        </a>
      )}
    </PageHero>

    <div class="md__nav">
      <nav class="pnn pnn--center" aria-label="Pagination">
        <div class="pnn__rail">
          <span class="pnn__rail-rule" aria-hidden="true"></span>
          <span class="pnn__rail-label">Other plenary meetings</span>
        </div>
        <div class="pnn__grid">
          {prevMeeting ? (
            <a href={`/meetings/${prevMeeting.ordinal}/`} class="pnn__cell pnn__cell--prev" rel="prev">
              <span class="pnn__arrow pnn__arrow--prev" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5" /><path d="M12 5l-7 7 7 7" /></svg>
              </span>
              <span class="pnn__body">
                <span class="pnn__hint">Previous</span>
                <span class="pnn__numeral">{prevMeeting.ordinal}</span>
                <span class="pnn__label">{ordinalText(prevMeeting.ordinal)}</span>
                <span class="pnn__caption">{navCaption(prevMeeting)}</span>
              </span>
            </a>
          ) : (
            <span class="pnn__cell pnn__cell--muted" aria-hidden="true">
              <span class="pnn__arrow pnn__arrow--prev pnn__arrow--silent" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5" /><path d="M12 5l-7 7 7 7" /></svg>
              </span>
              <span class="pnn__body"><span class="pnn__hint pnn__hint--silent">Beginning</span></span>
            </span>
          )}
          <span class="pnn__divider" aria-hidden="true"></span>
          {nextMeeting ? (
            <a href={`/meetings/${nextMeeting.ordinal}/`} class="pnn__cell pnn__cell--next" rel="next">
              <span class="pnn__body">
                <span class="pnn__hint">Next</span>
                <span class="pnn__numeral">{nextMeeting.ordinal}</span>
                <span class="pnn__label">{ordinalText(nextMeeting.ordinal)}</span>
                <span class="pnn__caption">{navCaption(nextMeeting)}</span>
              </span>
              <span class="pnn__arrow pnn__arrow--next" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5l7 7-7 7" /></svg>
              </span>
            </a>
          ) : (
            <span class="pnn__cell pnn__cell--muted" aria-hidden="true">
              <span class="pnn__body"><span class="pnn__hint pnn__hint--silent">Latest</span></span>
              <span class="pnn__arrow pnn__arrow--next pnn__arrow--silent" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5l7 7-7 7" /></svg>
              </span>
            </span>
          )}
        </div>
      </nav>
    </div>

    <div class="md__body">
      <nav class="md__quick-links" aria-label="Meeting actions">
        {meeting.primary.iso_meeting_url && (
          <a href={meeting.primary.iso_meeting_url} target="_blank" rel="noopener noreferrer" class="quick-link">
            ISO committee meeting <span aria-hidden="true">↗</span>
          </a>
        )}
        {meetingResolutions.length > 0 && (
          <div class="urn-bar">
            <span class="urn-bar__label">{meetingResolutions.length} resolution{meetingResolutions.length === 1 ? '' : 's'}</span>
          </div>
        )}
      </nav>

      {meeting.primary.cancellation_comment && (
        <section class="alert alert--cancelled">
          <h3 class="alert__title">This meeting was cancelled</h3>
          <p class="alert__body">{meeting.primary.cancellation_comment}</p>
        </section>
      )}

      {meeting.primary.reschedule_note && (
        <section class="alert alert--reschedule">
          <h3 class="alert__title">Rescheduled</h3>
          <p class="alert__body">
            {meeting.primary.reschedule_note}
            {meeting.primary.reschedule_timeframe && <> ({meeting.primary.reschedule_timeframe})</>}
          </p>
        </section>
      )}

      {rich?.venues?.length ? (
        <section class="block">
          <h2 class="block__title">Venue</h2>
          {rich.venues.map((v) => (
            <div class="venue-layout">
              <div class="venue-card venue-card--stacked">
                <div class="venue-card__main">
                  {v.name && <p class="venue-card__name">{v.name}</p>}
                  {v.address && <pre class="venue-card__address">{v.address}</pre>}
                  {v.note && <p class="venue-card__note">{v.note}</p>}
                  <div class="venue-card__links">
                    {v.link && <a href={v.link} target="_blank" rel="noopener noreferrer">Venue website →</a>}
                    {mapUrl && <a href={mapUrl} target="_blank" rel="noopener noreferrer">OpenStreetMap →</a>}
                  </div>
                </div>
              </div>
              {venueEmbedSrc(v) && (
                <div class="venue-map">
                  <iframe
                    src={venueEmbedSrc(v)!}
                    title={`Map showing ${v.name ?? 'meeting venue'}`}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                  ></iframe>
                  <small class="venue-map__credit">
                    Map data &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors
                  </small>
                </div>
              )}
            </div>
          ))}
        </section>
      ) : (rich?.general_area || meeting.location_label) && (
        <section class="block">
          <h2 class="block__title">Location</h2>
          <p class="block__scalar">{rich?.general_area || meeting.location_label}</p>
        </section>
      )}

      {(resolvedHosts.length > 0 || rich?.host) && (
        <section class="block">
          <h2 class="block__title">Hosted by</h2>
          <div class="host-grid">
            {resolvedHosts.map((h) => (
              <a class:list={["host-card", { 'host-card--linkable': !!h.path }]} href={h.path || undefined}>
                {(h.logo || h.logo_light || h.logo_dark) ? (
                  <OrgLogo logo={h.logo} logo_light={h.logo_light} logo_dark={h.logo_dark} size="md" radius="0.375rem" fallbackText={h.short_name ?? h.name} alt={h.name} />
                ) : (
                  <div class="host-card__monogram" aria-hidden="true">{(h.name || '?').slice(0, 2).toUpperCase()}</div>
                )}
                <div class="host-card__meta">
                  <p class="host-card__name">{h.name}</p>
                  {h.kind === 'liaison' && <p class="host-card__kind">Liaison organization</p>}
                  {h.kind === 'national-body' && <p class="host-card__kind">National body</p>}
                  {h.contact?.name && (
                    <p class="host-card__contact">
                      <span class="host-card__contact-name">{h.contact.name}</span>
                      {h.contact.title && <span class="host-card__contact-title">{h.contact.title}</span>}
                    </p>
                  )}
                  {h.path && <p class="host-card__link">View profile <span aria-hidden="true">→</span></p>}
                  {!h.path && h.url && (
                    <a href={h.url} target="_blank" rel="noopener noreferrer" class="host-card__link">
                      Visit website <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </a>
            ))}
            {resolvedHosts.length === 0 && rich?.host && <p class="host-grid__plain">{rich.host}</p>}
          </div>
        </section>
      )}

      {resolvedAssociates.length > 0 && (
        <section class="block">
          <h2 class="block__title">In association with</h2>
          <ul class="assoc-list">
            {resolvedAssociates.map((a) => (
              <li class:list={[`assoc assoc--${a.kind}`, { 'assoc--linkable': !!(a.path || a.url) }]}>
