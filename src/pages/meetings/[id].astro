                    {res.isAcclamation ? (
                      <span class="res-card__kind res-card__kind--acclamation">Acclamation</span>
                    ) : (
                      <>
                        <span class="res-card__id">{res.id}</span>
                        <span class="res-card__kind">{res.kind === 'resolution' ? 'Plenary' : res.kind}</span>
                      </>
                    )}
                  </div>
                  <p class="res-card__title">{res.isAcclamation ? 'Acclamation' : (res.title || `Resolution ${res.id}`)}</p>
