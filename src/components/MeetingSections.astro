---
import type { RichMeeting, MeetingSession } from '../lib/data'
import { rateLabel } from '../lib/meeting'
import { formatDateCompact } from '../lib/presentation'
import {
  practicalLabel, touristItems, practicalEntries, sectionEntries,
  isSection, isStringList, isUrl, isEmail,
} from '../lib/meeting'
import { sessionLabel, sessionLocation, sessionVirtual } from '../lib/meeting'

// The data-loop sections of a meeting page. Each renders only when its
// rich-data slice is present; the page composes them in order.
interface Props {
  rich?: RichMeeting
  sessions: MeetingSession[]
}
const { rich, sessions } = Astro.props
---
    {rich?.accommodation_options?.length ? (
      <section class="block">
        <h2 class="block__title">Accommodation</h2>
        <ul class="list-card">
          {rich.accommodation_options.map((a) => (
            <li class="list-card__item list-card__item--rich">
              <div class="list-card__head">
                {a.link ? (
                  <a href={a.link} target="_blank" rel="noopener noreferrer" class="list-card__name">{a.name}</a>
                ) : (
                  <span class="list-card__name">{a.name}</span>
                )}
                {a.distance && <span class="list-card__chip">{a.distance}</span>}
                {a.code && <span class="list-card__chip list-card__chip--code">Booking code: {a.code}</span>}
              </div>
              {a.address && <p class="list-card__meta">{a.address}</p>}
              {a.email && <p class="list-card__meta"><a href={`mailto:${a.email}`}>{a.email}</a></p>}
              {a.rates && Object.keys(a.rates).length > 0 ? (
                <dl class="list-card__rates">
                  {Object.entries(a.rates).map(([k, v]) => (
                    <><dt>{rateLabel(k)}</dt><dd>{v}</dd></>
                  ))}
                </dl>
              ) : a.price && <p class="list-card__meta">{a.price}</p>}
              {a.breakfast && <p class="list-card__meta list-card__meta--soft">Breakfast: {a.breakfast}</p>}
              {a.notes && <p class="list-card__notes">{a.notes}</p>}
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    {rich?.practical_info && practicalEntries(rich.practical_info).length > 0 && (
      <section class="block">
        <h2 class="block__title">Practical information</h2>
        <div class="practical">
          {practicalEntries(rich.practical_info).map(([key, value]) => (
            <div class="practical__entry">
              <p class="practical__label">{practicalLabel(key)}</p>
              {isSection(value) ? (
                <div class="practical__section">
                  <dl class="practical__dl">
                    {sectionEntries(value).map(([subKey, subVal]) => (
                      <>
                        <dt class="practical__dt">{practicalLabel(subKey)}</dt>
                        <dd class="practical__dd">
                          {typeof subVal === 'boolean' ? (subVal ? 'Yes' : 'No') : (
                            isUrl(subVal) ? <a href={subVal} target="_blank" rel="noopener noreferrer">{subVal}</a>
                            : isEmail(subVal) ? <a href={`mailto:${subVal}`}>{subVal}</a>
                            : isStringList(subVal) ? (
                              <ul class="practical__list">
                                {subVal.map((item) => <li>{item}</li>)}
                              </ul>
                            ) : <span>{String(subVal)}</span>
                          )}
                        </dd>
                      </>
                    ))}
                  </dl>
                </div>
              ) : isStringList(value) ? (
                <ul class="practical__list practical__list--top">
                  {value.map((item) => <li>{item}</li>)}
                </ul>
              ) : (
                <p class="practical__scalar">
                  {isUrl(value) ? <a href={value} target="_blank" rel="noopener noreferrer">{value}</a> : <span>{String(value)}</span>}
                </p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {rich?.lunch_recommendations?.length ? (
      <section class="block">
        <h2 class="block__title">Lunch recommendations</h2>
        <ul class="list-card">
          {rich.lunch_recommendations.map((l) => (
            <li class="list-card__item">
              {(l.link || l.url) ? (
                <a href={l.link || l.url} target="_blank" rel="noopener noreferrer" class="list-card__name">{l.name}</a>
              ) : (
                <span class="list-card__name">{l.name}</span>
              )}
              {l.address && <p class="list-card__meta">{l.address}</p>}
              {l.notes && <p class="list-card__notes">{l.notes}</p>}
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    {rich?.biergartens?.length ? (
      <section class="block">
        <h2 class="block__title">Biergartens &amp; evenings</h2>
        <ul class="list-card">
          {rich.biergartens.map((b) => (
            <li class="list-card__item list-card__item--rich">
              <div class="list-card__head">
                {(b.link || b.url) ? (
                  <a href={b.link || b.url} target="_blank" rel="noopener noreferrer" class="list-card__name">{b.name}</a>
                ) : (
                  <span class="list-card__name">{b.name}</span>
                )}
                {b.walk_minutes && <span class="list-card__chip">{b.walk_minutes} min walk</span>}
              </div>
              {b.address && <p class="list-card__meta">{b.address}</p>}
              {b.style && <p class="list-card__meta list-card__meta--soft">{b.style}</p>}
              {b.notes && <p class="list-card__notes">{b.notes}</p>}
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    {touristItems(rich?.tourist_info).length > 0 && (
      <section class="block">
        <h2 class="block__title">Things to see</h2>
        <div class="practical">
          {touristItems(rich.tourist_info).map((t) => (
            <div class="practical__entry tourist__entry">
              {t.link ? (
                <a href={t.link} target="_blank" rel="noopener noreferrer" class="tourist__name">{t.name} <span aria-hidden="true">↗</span></a>
              ) : (
                <p class="tourist__name tourist__name--plain">{t.name}</p>
              )}
              {t.notes && <p class="tourist__notes">{t.notes}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    {rich?.deadlines?.length ? (
      <section class="block">
        <h2 class="block__title">Key dates &amp; deadlines</h2>
        <ul class="deadlines">
          {rich.deadlines.map((d) => (
            <li class="deadlines__item">
              {d.date && <span class="deadlines__date">{formatDateCompact(d.date)}</span>}
              <div>
                {d.label && <p class="deadlines__label">{d.label}</p>}
                {d.description && <p class="deadlines__desc">{d.description}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    {sessions.length > 1 && (
      <section class="block">
        <h2 class="block__title">All sessions ({sessions.length})</h2>
        <ul class="sessions">
          {sessions.map((s) => (
            <li class="sessions__item">
              <div class="sessions__meta">
                <span class="sessions__type">{s.type === 'hybrid' ? 'Hybrid' : s.type === 'virtual' ? 'Virtual' : 'In person'}</span>
                {s.iso_meeting_url ? (
                  <a href={s.iso_meeting_url} target="_blank" rel="noopener noreferrer" class="sessions__link">ISO #{s.iso_meeting_id} ↗</a>
                ) : s.iso_meeting_id ? (
                  <span class="sessions__link sessions__link--plain">ISO #{s.iso_meeting_id}</span>
                ) : null}
              </div>
              {sessionLabel(s) && <p class="sessions__date">{sessionLabel(s)}</p>}
              {sessionLocation(s) && <p class="sessions__loc">{sessionLocation(s)}</p>}
              {sessionVirtual(s) && <p class="sessions__virtual">Online · {sessionVirtual(s)}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}

<style>
/* LISTS */
.list-card {
  list-style: none; margin: 0; padding: 0;
  display: grid; grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
  gap: 0.625rem;
}
.list-card__item {
  background: #fafaf9;
  padding: 0.75rem 1rem;
  border-radius: 0.375rem;
}
.list-card__item--rich { padding: 0.875rem 1.125rem; }
:global(.dark) .list-card__item { background: #292524; }
.list-card__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; margin-bottom: 0.25rem; }
.list-card__chip {
  display: inline-block;
  padding: 0.125rem 0.5rem;
  font-size: 0.6875rem;
  font-weight: 600;
  border-radius: 0.25rem;
  background: rgb(30 58 138 / 0.08);
  color: var(--color-blue-accent);
}
:global(.dark) .list-card__chip { background: rgb(148 182 232 / 0.12); }
.list-card__chip--code { background: rgb(180 83 9 / 0.08); color: var(--color-amber-warm, #b45309); }
:global(.dark) .list-card__chip--code { background: rgb(180 83 9 / 0.16); color: #fbbf24; }
.list-card__rates {
  margin: 0.375rem 0 0;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0.125rem 0.625rem;
  font-size: 0.8125rem;
}
.list-card__rates dt { color: #78716c; text-transform: capitalize; }
:global(.dark) .list-card__rates dt { color: #a8a29e; }
.list-card__rates dd { margin: 0; color: #1c1917; font-weight: 600; font-family: ui-monospace, monospace; }
:global(.dark) .list-card__rates dd { color: #fafaf9; }
.list-card__name { font-weight: 600; color: var(--color-blue-accent); }
.list-card__name a { color: inherit; text-decoration: none; }
.list-card__name a:hover { text-decoration: underline; }
.list-card__meta { font-size: 0.8125rem; color: #78716c; margin: 0.25rem 0 0; }
:global(.dark) .list-card__meta { color: #a8a29e; }
.list-card__meta--soft { font-style: italic; }
.list-card__meta a { color: inherit; text-decoration: underline; }
.list-card__notes { font-size: 0.875rem; color: #57534e; margin: 0.25rem 0 0; }
:global(.dark) .list-card__notes { color: #d6d3d1; }

/* PRACTICAL */
.practical {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
  gap: 0.625rem;
}
.practical__entry {
  background: #fafaf9;
  padding: 0.75rem 1rem;
  border-radius: 0.375rem;
}
:global(.dark) .practical__entry { background: #292524; }
.practical__label {
  font-size: 0.6875rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.08em;
  color: #78716c;
  margin: 0 0 0.375rem;
}
:global(.dark) .practical__label { color: #a8a29e; }
.practical__scalar { margin: 0; color: #57534e; font-size: 0.875rem; word-break: break-word; }
:global(.dark) .practical__scalar { color: #d6d3d1; }
.practical__scalar a { color: var(--color-blue-accent); }
.tourist__name { margin: 0; font-size: 0.9375rem; font-weight: 600; color: var(--color-blue-accent); text-decoration: none; }
.tourist__name:hover { text-decoration: underline; }
.tourist__name--plain { color: #1c1917; }
:global(.dark) .tourist__name--plain { color: #fafaf9; }
.tourist__notes { margin: 0.375rem 0 0; font-size: 0.8125rem; line-height: 1.5; color: #78716c; }
:global(.dark) .tourist__notes { color: #a8a29e; }
.practical__dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 0.625rem; }
.practical__dt { font-size: 0.75rem; color: #78716c; font-weight: 500; }
:global(.dark) .practical__dt { color: #a8a29e; }
.practical__dd { margin: 0; font-size: 0.875rem; color: #57534e; word-break: break-word; }
:global(.dark) .practical__dd { color: #d6d3d1; }
.practical__dd a { color: var(--color-blue-accent); }
.practical__list { margin: 0; padding-left: 1.125rem; }
.practical__list--top { font-size: 0.875rem; color: #57534e; }
:global(.dark) .practical__list--top { color: #d6d3d1; }

/* DEADLINES */
.deadlines { list-style: none; margin: 0; padding: 0; }
.deadlines__item {
  display: grid; grid-template-columns: 12rem 1fr;
  gap: 1rem;
  padding: 0.625rem 0;
  border-bottom: 1px dashed #e7e5e4;
}
:global(.dark) .deadlines__item { border-bottom-color: #292524; }
.deadlines__item:last-child { border-bottom: 0; }
.deadlines__date {
  font-family: var(--font-serif);
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-brand);
  letter-spacing: -0.01em;
}
.deadlines__label { font-weight: 600; margin: 0; color: #1c1917; }
:global(.dark) .deadlines__label { color: #fafaf9; }
.deadlines__desc { font-size: 0.875rem; color: #57534e; margin: 0.125rem 0 0; }
:global(.dark) .deadlines__desc { color: #d6d3d1; }

/* SESSIONS */
.sessions { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.625rem; }
.sessions__item {
  background: #fafaf9;
  padding: 0.875rem 1rem;
  border-radius: 0.375rem;
  border-left: 3px solid #d6d3d1;
}
:global(.dark) .sessions__item { background: #292524; border-left-color: #57534e; }
.sessions__meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.375rem; gap: 0.625rem; }
.sessions__type {
  font-size: 0.6875rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.08em;
  color: #57534e;
}
:global(.dark) .sessions__type { color: #a8a29e; }
.sessions__link { font-size: 0.8125rem; color: var(--color-blue-accent); text-decoration: none; }
.sessions__link:hover { text-decoration: underline; }
.sessions__link--plain { color: #a8a29e; }
.sessions__date { margin: 0; font-weight: 600; color: #1c1917; font-size: 0.9375rem; }
:global(.dark) .sessions__date { color: #fafaf9; }
.sessions__loc { margin: 0.125rem 0 0; font-size: 0.875rem; color: #57534e; }
:global(.dark) .sessions__loc { color: #d6d3d1; }
.sessions__virtual { margin: 0.125rem 0 0; font-size: 0.8125rem; color: #78716c; }
:global(.dark) .sessions__virtual { color: #a8a29e; }

/* RESOLUTIONS */
.res-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
.res-card {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.5rem 1rem;
  padding: 0.875rem 1rem;
  background: #fff;
  border: 1px solid #e7e5e4;
  border-radius: 0.5rem;
  text-decoration: none;
  color: inherit;
  transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
}
:global(.dark) .res-card { background: rgb(15 23 42 / 0.5); border-color: #44403c; }
.res-card:hover {
  border-color: var(--color-brand);
  box-shadow: 0 4px 12px rgb(185 28 28 / 0.08);
  transform: translateY(-1px);
}
:global(.dark) .res-card:hover { box-shadow: 0 4px 12px rgb(0 0 0 / 0.25); }
.res-card__head { display: flex; align-items: baseline; gap: 0.5rem; }
.res-card__id { font-family: ui-monospace, monospace; font-size: 0.8125rem; font-weight: 700; color: var(--color-brand); }
.res-card__kind {
  font-size: 0.6875rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.06em;
  color: #78716c;
}
:global(.dark) .res-card__kind { color: #a8a29e; }
.res-card__kind--acclamation {
  background: #6366f1; color: #fff;
  padding: 0.125rem 0.5rem;
  border-radius: 0.25rem;
}
.res-card__title {
  grid-column: 1 / -1;
  margin: 0;
  font-weight: 600;
  font-size: 0.9375rem;
  color: #1c1917;
  line-height: 1.4;
}
:global(.dark) .res-card__title { color: #fafaf9; }
.res-card:hover .res-card__title { color: var(--color-brand); }
.res-card__snippet {
  grid-column: 1 / -1;
  margin: 0;
  font-size: 0.875rem;
  color: #57534e;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
:global(.dark) .res-card__snippet { color: #d6d3d1; }
.res-card__subject {
  font-size: 0.6875rem; font-weight: 600;
  color: #78716c;
  background: #f5f5f4;
  padding: 0.125rem 0.5rem;
  border-radius: 0.25rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 18rem;
}
:global(.dark) .res-card__subject { background: #292524; color: #d6d3d1; }
.res-card__arrow {
  font-size: 1.125rem;
  color: #d6d3d1;
  align-self: center;
  transition: transform 0.15s, color 0.15s;
}
.res-card:hover .res-card__arrow { color: var(--color-brand); transform: translateX(2px); }

@media (max-width: 640px) {
  .md-hero__stats { grid-template-columns: 1fr 1fr; }
  .schedule__item { grid-template-columns: 1fr; gap: 0.25rem; }
  .deadlines__item { grid-template-columns: 1fr; gap: 0.25rem; }
}
</style>
