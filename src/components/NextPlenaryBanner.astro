---
import { loadData } from '../lib/data'
import { plenaryStatus } from '../lib/plenary-status'
import { flagEmoji, ordinalText } from '../lib/presentation'

// Live plenary banner for the home hero. Everything visible (flag, venue,
// ordinal, status) derives from meta.current.nextPlenary — nothing is
// hardcoded per meeting. The status line and banner visibility are
// recomputed at runtime against the viewer's UTC clock (script below), so
// the banner stays correct between rebuilds; the build-time value below is
// the no-JS fallback.
const np = loadData.meta().current.nextPlenary
const fallback = plenaryStatus(new Date(), np?.from_date, np?.to_date)

const flag = flagEmoji(np?.country_code)
const area = np?.general_area ?? 'Plenary meeting'

function fmtRange(from: string | null | undefined, to: string | null | undefined): string {
  if (!from || !to) return ''
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
  const f = new Date(from + 'T00:00:00Z')
  const t = new Date(to + 'T00:00:00Z')
  const fStr = `${months[f.getUTCMonth()]} ${f.getUTCDate()}`
  const tStr = f.getUTCMonth() === t.getUTCMonth() ? `${t.getUTCDate()}` : `${months[t.getUTCMonth()]} ${t.getUTCDate()}`
  return `${fStr}–${tStr}, ${t.getUTCFullYear()}`
}
const range = fmtRange(np?.from_date, np?.to_date)
---

{np && np.from_date && (
  <aside class="plenary-banner" aria-label="Plenary meeting banner" data-plenary-from={np.from_date} data-plenary-to={np.to_date} hidden={!fallback.active}>
    {flag && <div class="plenary-banner__flag" aria-hidden="true">{flag}</div>}
    <div class="plenary-banner__main">
      <p class="plenary-banner__eyebrow">
        <span class="plenary-banner__pulse" aria-hidden="true"></span>
        <span data-plenary-status>{fallback.line}</span>
      </p>
      <h2 class="plenary-banner__title">{area}</h2>
      <p class="plenary-banner__meta">
        {range && <span>{range}</span>}
        {range && <span aria-hidden="true">—</span>}
        <span>The {ordinalText(np.ordinal)} plenary week of ISO/TC 154</span>
      </p>
    </div>
    <div class="plenary-banner__actions">
      {np.registration_url && (
        <a href={np.registration_url} target="_blank" rel="noopener noreferrer" class="plenary-banner__cta plenary-banner__cta--primary" data-plenary-register hidden={fallback.daysUntilStart < 1}>
          Register
        </a>
      )}
      <a href={np.url} class="plenary-banner__cta">
        Meeting briefing <span aria-hidden="true">→</span>
      </a>
    </div>
  </aside>
)}

<script>
  import { plenaryStatus } from '../lib/plenary-status'

  function updatePlenaryBanner(): void {
    const el = document.querySelector<HTMLElement>('.plenary-banner[data-plenary-from]')
    if (!el) return
    const s = plenaryStatus(new Date(), el.dataset.plenaryFrom, el.dataset.plenaryTo)
    const line = el.querySelector('[data-plenary-status]')
    if (line) line.textContent = s.line
    el.hidden = !s.active
    const register = el.querySelector<HTMLElement>('[data-plenary-register]')
    if (register) register.hidden = s.daysUntilStart < 1
  }

  updatePlenaryBanner()
  setInterval(updatePlenaryBanner, 60_000)
</script>

<style>
  .plenary-banner[hidden] { display: none; }
  .plenary-banner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin: 0 0 2.5rem;
    padding: 1.125rem 1.5rem;
    border-radius: 0.875rem;
    background:
      radial-gradient(ellipse at top right, rgb(30 58 138 / 0.5), transparent 65%),
      linear-gradient(135deg, #0f1e3a 0%, #1e3a8a 55%, #2a4a9c 100%);
    border: 1px solid rgb(148 182 232 / 0.4);
    box-shadow: 0 12px 32px -12px rgb(30 58 138 / 0.45);
    position: relative;
    overflow: hidden;
  }
  .plenary-banner::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-iso-red);
  }
  :global(.dark) .plenary-banner {
    background:
      radial-gradient(ellipse at top right, rgb(148 182 232 / 0.25), transparent 65%),
      linear-gradient(135deg, #101b30 0%, #16294d 60%, #1d3660 100%);
  }

  .plenary-banner__flag {
    font-size: 2rem;
    line-height: 1;
    filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.3));
  }

  .plenary-banner__main { flex: 1 1 16rem; min-width: 0; }

  .plenary-banner__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.375rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #a8c4ee;
  }
  .plenary-banner__pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #7dd3a8;
    box-shadow: 0 0 0 0 rgb(125 211 168 / 0.6);
    animation: plenary-pulse 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes plenary-pulse {
    0% { box-shadow: 0 0 0 0 rgb(125 211 168 / 0.6); }
    70% { box-shadow: 0 0 0 0.5rem rgb(125 211 168 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(125 211 168 / 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .plenary-banner__pulse { animation: none; }
  }

  .plenary-banner__title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: #fff;
    margin: 0 0 0.375rem;
  }
  .plenary-banner__amp {
    font-weight: 400;
    font-style: italic;
    opacity: 0.55;
  }

  .plenary-banner__meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.82);
  }
  .plenary-banner__meta sup { font-size: 0.6em; }

  .plenary-banner__actions {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }
  .plenary-banner__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 1.125rem;
    border-radius: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.35);
    background: rgb(255 255 255 / 0.08);
    backdrop-filter: blur(6px);
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
    white-space: nowrap;
  }
  .plenary-banner__cta:hover {
    background: rgb(255 255 255 / 0.16);
    border-color: rgb(255 255 255 / 0.6);
    transform: translateY(-1px);
  }
  .plenary-banner__cta--primary {
    background: #fff;
    color: #1e3a8a;
    border-color: #fff;
  }
  .plenary-banner__cta--primary:hover {
    background: #e7edf8;
    border-color: #e7edf8;
  }

  @media (max-width: 640px) {
    .plenary-banner { padding: 1rem 1.125rem; }
    .plenary-banner__actions { width: 100%; }
    .plenary-banner__cta { flex: 1; justify-content: center; }
  }
</style>
