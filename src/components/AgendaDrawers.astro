---
import { formatDateLong } from '../lib/presentation'
import type { AgendaDrawer } from '../lib/meeting'

// The plenary agenda drawers: hidden panels opened by clicking a matching
// calendar event (ScheduleCalendar carries data-agenda-date). Owns its markup,
// open/close behaviour, styles, and the key-to-date JSON island.
interface Props {
  sessions: AgendaDrawer[]
  sourceDoc?: string
  draftDate?: string | null
}
const { sessions, sourceDoc = '', draftDate = null } = Astro.props
---
{sessions.map((s) => (
  <div class="ad" data-agenda={s.key} hidden>
    <div class="ad__backdrop" data-close-agenda></div>
    <aside class="ad__panel" role="dialog" aria-label={`${s.label} agenda`} aria-modal="true">
      <header class="ad__header">
        <div class="ad__title-block">
          <p class="ad__eyebrow">{s.label}</p>
          <h3 class="ad__date">{formatDateLong(s.date)}</h3>
          {draftDate && <p class="ad__draft">Draft of {draftDate}</p>}
        </div>
        <button class="ad__close" data-close-agenda aria-label="Close agenda">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </header>
      {s.note && <p class="ad__note">{s.note}</p>}
      <div class="ad__body">
        <div class="ad__table-wrap">
          <table class="ad__table">
            <thead>
              <tr>
                <th scope="col" class="ad__th ad__th--seq">Seq</th>
                <th scope="col" class="ad__th ad__th--title">Title</th>
                <th scope="col" class="ad__th ad__th--resp">Responsible</th>
                <th scope="col" class="ad__th ad__th--ref">Ref.</th>
              </tr>
            </thead>
            <tbody>
              {s.rows.map((row) => (
                <tr class:list={{ 'ad__tr--sub': row.depth > 0 }}>
                  <td class="ad__td ad__td--seq">{row.seq}</td>
                  <td class="ad__td ad__td--title" style={`padding-left:${0.5 + row.depth * 1.125}rem`}>{row.title}</td>
                  <td class="ad__td ad__td--resp">{row.responsible}</td>
                  <td class="ad__td ad__td--ref">{row.ref}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      {sourceDoc && <footer class="ad__footer">Source: {sourceDoc}</footer>}
    </aside>
  </div>
))}
<script is:inline type="application/json" id="agenda-dates" set:html={JSON.stringify(Object.fromEntries(sessions.map((s) => [s.key, s.date])))} />

<script>
  // Agenda drawer: clicking a clickable calendar event opens the drawer whose
  // session date matches; Escape/backdrop/button close it.
  const drawers = Array.from(document.querySelectorAll<HTMLElement>('[data-agenda]'))
  const dateToKey = new Map<string, string>()
  const KEY_DATES: Record<string, string> = JSON.parse(document.getElementById('agenda-dates')?.textContent || '{}')
  for (const [key, date] of Object.entries(KEY_DATES)) dateToKey.set(date, key)

  function open(key: string) {
    drawers.forEach((d) => { d.hidden = d.dataset.agenda !== key })
    document.body.style.overflow = 'hidden'
  }
  function close() {
    drawers.forEach((d) => { d.hidden = true })
    document.body.style.overflow = ''
  }

  document.querySelectorAll<HTMLElement>('[data-agenda-date]').forEach((el) => {
    const handler = (e: Event) => {
      e.preventDefault()
      const key = dateToKey.get(el.dataset.agendaDate || '')
      if (key) open(key)
    }
    el.addEventListener('click', handler)
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter') handler(e) })
  })
  document.querySelectorAll('[data-close-agenda]').forEach((el) => el.addEventListener('click', close))
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape') close() })
</script>

<style scoped>
.ad {
  position: fixed;
  inset: 0;
  z-index: 100;
}

.ad__backdrop {
  position: absolute;
  inset: 0;
  background: rgb(0 0 0 / 0.4);
  backdrop-filter: blur(2px);
}

.ad__panel {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: min(34rem, 92vw);
  background: #ffffff;
  box-shadow: -8px 0 32px rgb(0 0 0 / 0.18);
  display: flex;
  flex-direction: column;
}
:global(.dark) .ad__panel {
  background: #1c1917;
  box-shadow: -8px 0 32px rgb(0 0 0 / 0.5);
}

.ad__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.25rem 1.5rem 1rem;
  border-bottom: 1px solid #e7e5e4;
  flex-shrink: 0;
}
:global(.dark) .ad__header { border-bottom-color: #292524; }

.ad__title-block { min-width: 0; }

.ad__eyebrow {
  margin: 0 0 0.25rem;
  font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  font-size: 0.625rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-iso-red, #b91c1c);
}
.ad__date {
  margin: 0;
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: #1c1917;
  letter-spacing: -0.015em;
  line-height: 1.2;
}
:global(.dark) .ad__date { color: #fafaf9; }
.ad__draft {
  margin: 0.25rem 0 0;
  font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  font-size: 0.6875rem;
  font-weight: 600;
  color: #78716c;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
:global(.dark) .ad__draft { color: #a8a29e; }

.ad__close {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border: 0;
  border-radius: 0.375rem;
  background: transparent;
  color: #78716c;
  cursor: pointer;
  transition: background 120ms ease, color 120ms ease;
}
.ad__close:hover {
  background: #f5f5f4;
  color: #1c1917;
}
:global(.dark) .ad__close { color: #a8a29e; }
:global(.dark) .ad__close:hover {
  background: #292524;
  color: #fafaf9;
}

.ad__note {
  margin: 0;
  padding: 0.625rem 1.5rem;
  font-size: 0.8125rem;
  line-height: 1.55;
  color: #57534e;
  background: #fafaf9;
  border-bottom: 1px solid #e7e5e4;
  flex-shrink: 0;
}
:global(.dark) .ad__note {
  color: #d6d3d1;
  background: #292524;
  border-bottom-color: #44403c;
}

.ad__body {
  flex: 1;
  overflow-y: auto;
  min-height: 0;
}

.ad__table-wrap {
  border-top: 1px solid #e7e5e4;
  border-bottom: 1px solid #e7e5e4;
}
:global(.dark) .ad__table-wrap {
  border-top-color: #44403c;
  border-bottom-color: #44403c;
}

.ad__table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}
.ad__th {
  padding: 0.5rem 0.625rem;
  text-align: left;
  font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  font-size: 0.625rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #78716c;
  border-bottom: 1px solid #d6d3d1;
  vertical-align: bottom;
  white-space: nowrap;
}
:global(.dark) .ad__th {
  color: #a8a29e;
  border-bottom-color: #57534e;
}
.ad__th--seq { width: 3rem; text-align: right; padding-right: 0.75rem; }
.ad__th--title { width: auto; }
.ad__th--resp { width: 7.5rem; }
.ad__th--ref { width: 5.5rem; }

.ad__td {
  padding: 0.5625rem 0.625rem;
  font-size: 0.8125rem;
  line-height: 1.45;
  vertical-align: top;
  border-bottom: 1px solid #e7e5e4;
}
:global(.dark) .ad__td { border-bottom-color: #292524; }
tr:last-child .ad__td { border-bottom: 0; }

.ad__td--seq {
  font-family: var(--font-serif);
  font-size: 0.9375rem;
  font-variant-numeric: tabular-nums;
  color: var(--color-iso-red, #b91c1c);
  text-align: right;
  padding-right: 0.75rem;
  white-space: nowrap;
  font-feature-settings: 'lnum', 'tnum';
}
.ad__td--title {
  color: #1c1917;
  word-wrap: break-word;
  overflow-wrap: anywhere;
}
:global(.dark) .ad__td--title { color: #fafaf9; }
.ad__td--resp {
  font-family: var(--font-sans);
  font-size: 0.75rem;
  color: #57534e;
}
:global(.dark) .ad__td--resp { color: #d6d3d1; }
.ad__td--ref {
  font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--color-blue-accent, #1e3a8a);
  letter-spacing: 0.02em;
  white-space: nowrap;
}
:global(.dark) .ad__td--ref { color: var(--color-brand-soft, #94b6e8); }

.ad__tr--sub .ad__td--seq {
  font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  font-size: 0.6875rem;
  font-weight: 600;
  color: #78716c;
}
:global(.dark) .ad__tr--sub .ad__td--seq { color: #a8a29e; }
.ad__tr--sub .ad__td--title {
  color: #44403c;
  font-weight: 400;
}
:global(.dark) .ad__tr--sub .ad__td--title { color: #d6d3d1; }

.ad__footer {
  flex-shrink: 0;
  padding: 0.625rem 1.5rem;
  font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  font-size: 0.6875rem;
  color: #a8a29e;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  border-top: 1px solid #e7e5e4;
}
:global(.dark) .ad__footer {
  color: #78716c;
  border-top-color: #292524;
}

.ad-enter-active,
.ad-leave-active {
  transition: opacity 200ms ease;
}
.ad-enter-active .ad__panel,
.ad-leave-active .ad__panel {
  transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
}
.ad-enter-from,
.ad-leave-to {
  opacity: 0;
}
.ad-enter-from .ad__panel,
.ad-leave-to .ad__panel {
  transform: translateX(100%);
}

@media (max-width: 720px) {
  .ad__th, .ad__td { padding-left: 0.375rem; padding-right: 0.375rem; }
  .ad__th--seq, .ad__td--seq { width: 2.5rem; padding-right: 0.5rem; }
  .ad__th--resp, .ad__td--resp { width: 5.5rem; }
  .ad__th--ref, .ad__td--ref { width: 4rem; }
  .ad__td { font-size: 0.75rem; }
  .ad__td--resp { font-size: 0.6875rem; }
  .ad__td--ref { font-size: 0.625rem; }
  .ad__td--seq { font-size: 0.8125rem; }
  .ad__header { padding: 1rem 1.125rem 0.875rem; }
  .ad__date { font-size: 1.0625rem; }
}

@media (prefers-reduced-motion: reduce) {
  .ad-enter-active,
  .ad-leave-active,
  .ad-enter-active .ad__panel,
  .ad-leave-active .ad__panel {
    transition: none;
  }
}
</style>
