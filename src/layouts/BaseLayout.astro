---
import fs from 'node:fs'
import '../styles/main.css'
import { committee } from '../data/committee'
import { mainNav } from '../data/navigation'

const meta = JSON.parse(fs.readFileSync('public/data/meta.json', 'utf-8')) as {
  counts: Record<string, number>
}

interface Props {
  title?: string
  description?: string
  ogImage?: string
  noIndex?: boolean
  bodyClass?: string
}

const {
  title = `${committee.name} — ${committee.tagline}`,
  description = committee.scope,
  ogImage = '/assets/og/iso-tc-154-card.png',
  noIndex = false,
  bodyClass = '',
} = Astro.props

const path = Astro.url.pathname
function isActive(to: string): boolean {
  if (to === '/') return path === '/'
  return path === to || path.startsWith(to)
}
function sectionContains(item: { to: string; children?: { to: string }[] }): boolean {
  if (isActive(item.to)) return true
  return item.children?.some((c) => isActive(c.to)) ?? false
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: committee.name,
      url: 'https://www.isotc154.org/',
      logo: 'https://www.isotc154.org/assets/iso-red.svg',
      sameAs: [committee.links.iso, committee.links.isoCommittee, committee.links.linkedin, committee.links.github],
      foundingDate: String(committee.established),
    })} />
    <script is:inline>
      // Apply theme before paint to avoid FOUC
      const theme = (() => {
        try {
          const stored = localStorage.getItem('theme')
          if (stored === 'light' || stored === 'dark') return stored
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        } catch {
          return 'light'
        }
      })()
      if (theme === 'dark') document.documentElement.classList.add('dark')
    </script>
  </head>
  <body class={bodyClass}>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <div class="site-brand-bar" aria-hidden="true"></div>

    <header id="nav-header" class="site-header">
      <div class="site-header__inner">
        <a href="/" class="site-header__logo">
          <img src="/assets/iso-red.svg" alt="ISO" />
          <span class="site-header__logo-text">
            {committee.name}
            <span class="site-header__logo-subtitle">{committee.tagline}</span>
          </span>
        </a>

        <nav class="site-header__nav" aria-label="Primary">
          {mainNav.map((item) => (
            item.children?.length ? (
              <div class="site-header__nav-group">
                <a href={item.to} class:list={["site-header__nav-link", { 'site-header__nav-link--active': sectionContains(item) }]}>
                  {item.label}
                  <svg viewBox="0 0 12 12" fill="currentColor"><path d="M6 8L2 4h8z" /></svg>
                </a>
                <div class="site-header__dropdown">
                  <div class="site-header__dropdown-inner">
                    {item.children.map((child) => (
                      <a href={child.to} class:list={["site-header__dropdown-item", { 'site-header__dropdown-item--active': isActive(child.to) }]}>{child.label}</a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a href={item.to} class:list={["site-header__nav-link", { 'site-header__nav-link--active': isActive(item.to) }]}>{item.label}</a>
            )
          ))}
        </nav>

        <div class="site-header__actions">
          <button type="button" class="site-header__icon-btn" id="site-search-open" aria-label="Search (Ctrl+K)">
            <svg class="header-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="11" cy="11" r="8" stroke-width="2"/><path d="m21 21-4.35-4.35" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <button type="button" class="site-header__icon-btn" id="theme-toggle" aria-label="Switch theme">
            <svg class="header-icon icon-sun" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            <svg class="header-icon icon-moon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
          </button>

          <button type="button" class="site-header__icon-btn site-header__icon-btn--mobile" id="mobile-menu-toggle" aria-label="Menu" aria-expanded="false">
            <svg class="header-icon icon-menu" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
            <svg class="header-icon icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>

      <div class="mobile-menu" id="mobile-menu" hidden>
        {mainNav.map((item) => (
          item.children?.length ? (
            <div class="mobile-menu__group">
              <button type="button" class="mobile-menu__toggle" data-toggle-for={item.to} aria-expanded="false">
                <span>{item.label}</span>
                <svg viewBox="0 0 12 12" fill="currentColor"><path d="M6 8L2 4h8z" /></svg>
              </button>
              <div class="mobile-menu__sub" data-sub-for={item.to} hidden>
                {item.children.map((child) => (
                  <a href={child.to} class="mobile-menu__link mobile-menu__link--sub">{child.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.to} class="mobile-menu__link">{item.label}</a>
          )
        ))}
        <span class="mobile-menu__section-title">External Links</span>
        <a href={committee.links.isoCommittee} target="_blank" rel="noopener noreferrer" class="mobile-menu__link">ISO Committee</a>
        <a href={committee.links.linkedin} target="_blank" rel="noopener noreferrer" class="mobile-menu__link">LinkedIn</a>
        <a href={committee.links.github} target="_blank" rel="noopener noreferrer" class="mobile-menu__link">GitHub</a>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__grid">
          <div class="site-footer__brand">
            <a href="/" class="site-footer__logo">
              <img src="/assets/iso-red.svg" alt="ISO" />
              <span class="site-footer__logo-text">{committee.name}</span>
            </a>
            <p class="site-footer__tagline">{committee.tagline}</p>
            <p class="site-footer__tagline">{committee.scope}</p>
          </div>

          <div>
            <h4 class="site-footer__heading">Committee</h4>
            <ul class="site-footer__facts">
              <li><strong>Secretariat:</strong> {committee.secretariat}</li>
              <li><strong>Chair:</strong> {committee.chair}</li>
              <li><strong>Established:</strong> {committee.established}</li>
              <li><strong>Standards:</strong> {meta.counts.publishedStandards} published</li>
              <li><strong>Members:</strong> {meta.counts.participatingMembers} (P), {meta.counts.observingMembers} (O)</li>
            </ul>
          </div>

          <div>
            <h4 class="site-footer__heading">Explore</h4>
            <ul class="site-footer__links">
              <li><a href="/standards/" class="site-footer__link">Standards</a></li>
              <li><a href="/members/" class="site-footer__link">Members</a></li>
              <li><a href="/meetings/" class="site-footer__link">Meetings</a></li>
              <li><a href="/resolutions/" class="site-footer__link">Resolutions</a></li>
              <li><a href="/posts/" class="site-footer__link">News</a></li>
            </ul>
          </div>

          <div>
            <h4 class="site-footer__heading">Links</h4>
            <ul class="site-footer__links">
              <li><a href={committee.links.iso} class="site-footer__link" target="_blank" rel="noopener noreferrer">ISO.org</a></li>
              <li><a href={committee.links.isoCommittee} class="site-footer__link" target="_blank" rel="noopener noreferrer">ISO.org Committee Page</a></li>
              <li class="site-footer__social">
                <a href={committee.links.linkedin} target="_blank" rel="noopener noreferrer" class="site-footer__icon-link" aria-label="LinkedIn">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" /></svg>
                </a>
                <a href={committee.links.github} target="_blank" rel="noopener noreferrer" class="site-footer__icon-link" aria-label="GitHub">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="site-footer__bottom">
          <p class="site-footer__copy">&copy; {new Date().getFullYear()} {committee.name}</p>
        </div>
      </div>
    </footer>

    <dialog id="site-search" class="omnibar">
      <div class="omnibar__box">
        <div class="omnibar__row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input id="omnibar-input" type="search" placeholder="Search standards, members, meetings, resolutions…" autocomplete="off" spellcheck="false" aria-label="Search the site" />
          <kbd>Esc</kbd>
        </div>
        <ul id="omnibar-results" role="listbox" aria-label="Search results"></ul>
        <p class="omnibar__hint">984 entries · standards, members, meetings, resolutions, news</p>
      </div>
    </dialog>

    <button class="scroll-to-top" id="scroll-to-top" aria-label="Scroll to top">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <script>
      // Theme toggle
      const themeBtn = document.getElementById('theme-toggle')
      themeBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark')
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light') } catch {}
      })

      // Mobile menu
      const mobileBtn = document.getElementById('mobile-menu-toggle')
      const mobileMenu = document.getElementById('mobile-menu')
      mobileBtn?.addEventListener('click', () => {
        const open = mobileMenu?.hasAttribute('hidden')
        if (open) {
          mobileMenu?.removeAttribute('hidden')
          mobileBtn.setAttribute('aria-expanded', 'true')
        } else {
          mobileMenu?.setAttribute('hidden', '')
          mobileBtn.setAttribute('aria-expanded', 'false')
        }
      })
      document.querySelectorAll('.mobile-menu__toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-toggle-for')
          const sub = document.querySelector(`[data-sub-for="${key}"]`)
          const expanded = btn.getAttribute('aria-expanded') === 'true'
          if (expanded) {
            sub?.setAttribute('hidden', '')
            btn.setAttribute('aria-expanded', 'false')
            btn.classList.remove('mobile-menu__toggle--open')
          } else {
            sub?.removeAttribute('hidden')
            btn.setAttribute('aria-expanded', 'true')
            btn.classList.add('mobile-menu__toggle--open')
          }
        })
      })

      // Scroll progress + scroll-to-top
      const progress = document.getElementById('scroll-progress')
      const toTop = document.getElementById('scroll-to-top')
      function handleScroll() {
        const scrollTop = document.documentElement.scrollTop || document.body.scrollTop
        const scrollHeight = document.documentElement.scrollHeight || document.body.scrollHeight
        const clientHeight = document.documentElement.clientHeight
        const height = scrollHeight - clientHeight
        const pct = height > 0 ? (scrollTop / height) * 100 : 0
        if (progress) progress.style.width = pct + '%'
        if (toTop) {
          if (scrollTop > 500) toTop.classList.add('scroll-to-top--visible')
          else toTop.classList.remove('scroll-to-top--visible')
        }
      }
      window.addEventListener('scroll', handleScroll, { passive: true })
      toTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))
      handleScroll()

      // ⌘K omnibar
      const dialog = document.getElementById('site-search') as HTMLDialogElement | null
      const input = document.getElementById('omnibar-input') as HTMLInputElement | null
      const list = document.getElementById('omnibar-results')
      const openBtn = document.getElementById('site-search-open')
      let entries: { t: string; s?: string; u: string; k?: string }[] | null = null
      let activeIdx = -1

      async function ensureIndex() {
        if (entries) return
        entries = await fetch('/data/search-index.json').then((r) => r.json())
      }

      function render(q: string) {
        if (!list || !entries) return
        const needle = q.trim().toLowerCase()
        const hits = needle
          ? entries.filter((e) => (e.t + ' ' + (e.s ?? '')).toLowerCase().includes(needle)).slice(0, 10)
          : entries.slice(0, 6)
        activeIdx = -1
        list.innerHTML = ''
        for (const e of hits) {
          const li = document.createElement('li')
          const a = document.createElement('a')
          a.href = e.u
          a.innerHTML = `<span class="omnibar__kind">${e.k ?? ''}</span><span class="omnibar__title"></span><span class="omnibar__sub"></span>`
          a.querySelector('.omnibar__title')!.textContent = e.t
          a.querySelector('.omnibar__sub')!.textContent = e.s ?? ''
          li.appendChild(a)
          list.appendChild(li)
        }
        if (!hits.length) {
          const li = document.createElement('li')
          li.className = 'omnibar__none'
          li.textContent = 'No matches.'
          list.appendChild(li)
        }
      }

      function setActive(i: number) {
        if (!list) return
        const items = list.querySelectorAll('a')
        items.forEach((a, j) => (a as HTMLElement).classList.toggle('omnibar__active', j === i))
        items[i]?.scrollIntoView({ block: 'nearest' })
      }

      openBtn?.addEventListener('click', async () => {
        dialog?.showModal()
        await ensureIndex()
        render('')
        input?.focus()
      })
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault()
          openBtn?.click()
        }
      })
      input?.addEventListener('input', () => render(input.value))
      input?.addEventListener('keydown', (e) => {
        if (!list) return
        const links = Array.from(list.querySelectorAll('a'))
        if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, links.length - 1); setActive(activeIdx) }
        if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); setActive(activeIdx) }
        if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); links[activeIdx]?.click() }
      })
    </script>
  </body>
</html>

<style is:global>
  .scroll-progress {
    position: fixed;
    top: 0; left: 0;
    width: 0;
    height: 3px;
    background: linear-gradient(90deg, #1e3a8a, #3b82f6);
    z-index: 100;
    transition: width 0.1s linear;
  }
  .scroll-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background-color: var(--color-blue-accent);
    color: white;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 15px -3px rgba(0, 97, 173, 0.4), 0 4px 6px -2px rgba(0, 97, 173, 0.2);
    z-index: 50;
  }
  .scroll-to-top--visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .scroll-to-top:hover {
    background-color: #172554;
    transform: translateY(-4px);
  }
  .scroll-to-top svg { width: 1.5rem; height: 1.5rem; }

  /* Omnibar (⌘K search) */
  .omnibar {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 40rem;
    width: calc(100vw - 2rem);
    margin: 12vh auto auto;
  }
  .omnibar::backdrop { background: rgb(15 23 42 / 0.5); backdrop-filter: blur(4px); }
  .omnibar__box {
    background: #fff;
    border: 1px solid #e7e5e4;
    border-radius: 0.875rem;
    box-shadow: 0 24px 48px -12px rgb(15 23 42 / 0.25);
    overflow: hidden;
  }
  .dark .omnibar__box { background: #232320; border-color: #2e2e2a; }
  .omnibar__row {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.875rem 1.125rem;
    border-bottom: 1px solid #e7e5e4;
    color: #78716c;
  }
  .dark .omnibar__row { border-bottom-color: #2e2e2a; }
  .omnibar__row input {
    flex: 1; border: none; outline: none; background: none;
    font-family: var(--font-sans); font-size: 1rem; color: #1c1917;
  }
  .dark .omnibar__row input { color: #e8e6e1; }
  .omnibar__row kbd {
    font-family: ui-monospace, monospace; font-size: 0.6875rem;
    border: 1px solid #d6d3d1; border-radius: 0.3125rem; padding: 0.0625rem 0.375rem; color: #a8a29e;
  }
  .omnibar__results, #omnibar-results {
    list-style: none; margin: 0; padding: 0.375rem;
    max-height: 24rem; overflow-y: auto;
  }
  #omnibar-results a {
    display: grid; grid-template-columns: 5.5rem 1fr; grid-template-rows: auto auto;
    column-gap: 0.75rem; align-items: baseline;
    padding: 0.5rem 0.625rem; border-radius: 0.5rem; text-decoration: none;
  }
  #omnibar-results a:hover, .omnibar__active { background: #f5f5f4; }
  .dark #omnibar-results a:hover, .dark .omnibar__active { background: #2e2e2a; }
  .omnibar__kind {
    grid-row: 1 / 3;
    font-family: var(--font-sans); font-size: 0.625rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-blue-accent);
  }
  .omnibar__title { font-family: var(--font-serif); font-size: 0.9375rem; font-weight: 600; color: #1c1917; }
  .dark .omnibar__title { color: #fafaf9; }
  .omnibar__sub { font-family: var(--font-sans); font-size: 0.75rem; color: #78716c; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .omnibar__none { padding: 1rem; text-align: center; color: #78716c; font-size: 0.875rem; }
  .omnibar__hint {
    padding: 0.5rem 1.125rem; margin: 0;
    border-top: 1px solid #e7e5e4;
    font-family: var(--font-sans); font-size: 0.6875rem; color: #a8a29e;
  }
  .dark .omnibar__hint { border-top-color: #2e2e2a; }
  @media (max-width: 640px) {
    .omnibar { margin-top: 6vh; }
    #omnibar-results a { grid-template-columns: 1fr; }
    .omnibar__kind { grid-row: auto; }
  }

  /* Theme + mobile-menu icon visibility */
  html:not(.dark) .icon-moon { display: none; }
  html:not(.dark) .icon-close { display: none; }
  html.dark .icon-sun { display: none; }
  html.dark .icon-menu { display: none; }
</style>
