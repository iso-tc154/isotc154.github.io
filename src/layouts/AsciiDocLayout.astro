---
import BaseLayout from './BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import { loadData, type PageDoc } from '../lib/data'

interface Props {
  page: PageDoc
  decorationPattern?: string
}

const { page, decorationPattern } = Astro.props
const title = page.frontmatter.title ?? page.url
const eyebrow = page.frontmatter.eyebrow ?? ''
const lead = page.frontmatter.lead ?? page.frontmatter.description ?? ''
---
<BaseLayout title={`${title} — ISO/TC 154`} description={lead || title}>
  <PageHero variant="index" bleed eyebrow={eyebrow} title={title} lead={lead}>
    {decorationPattern && (
      <Fragment slot="decoration">
        <div class={`hero-pattern hero-pattern--${decorationPattern}`}></div>
      </Fragment>
    )}
  </PageHero>
  <article class="page page--wide">
    <div class="prose" set:html={page.html} />
  </article>
</BaseLayout>

<style is:global>
  .prose {
    max-width: 48rem;
    font-size: 1rem; line-height: 1.7;
    color: var(--color-slate-700);
  }
  .dark .prose { color: var(--color-slate-300); }
  .prose h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.625rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-slate-900);
    margin: 2.5rem 0 1rem;
  }
  .dark .prose h1 { color: var(--color-slate-50); }
  .prose h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-slate-900);
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-slate-200);
  }
  .dark .prose h2 { color: var(--color-slate-50); border-bottom-color: var(--color-slate-700); }
  .prose h3 {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-slate-900);
    margin: 2rem 0 0.75rem;
  }
  .dark .prose h3 { color: var(--color-slate-50); }
  .prose h4 {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-slate-900);
    margin: 1.5rem 0 0.5rem;
  }
  .dark .prose h4 { color: var(--color-slate-50); }
  .prose p { margin: 0 0 1rem; }
  .prose a { color: var(--color-brand); text-decoration: underline; }
  .prose ul, .prose ol { margin: 0 0 1rem; padding-left: 1.5rem; }
  .prose li { margin-bottom: 0.375rem; }
  .prose code {
    font-family: ui-monospace, monospace;
    background: var(--color-wash);
    padding: 0.1rem 0.3rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  .dark .prose code { background: var(--color-slate-700); }
  .prose blockquote {
    border-left: 3px solid var(--color-brand);
    padding: 0.5rem 1rem;
    margin: 1.5rem 0;
    background: var(--color-slate-50);
    color: var(--color-slate-600);
  }
  .dark .prose blockquote {
    background: var(--color-slate-800);
    color: var(--color-slate-300);
    border-left-color: var(--color-blue-steel);
  }
  .prose table {
    display: block;
    overflow-x: auto;
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
    -webkit-overflow-scrolling: touch;
  }
  .prose th, .prose td {
    border: 1px solid var(--color-slate-200);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .dark .prose th, .dark .prose td { border-color: var(--color-slate-700); }
  .prose th { background: var(--color-slate-50); font-weight: 700; }
  .dark .prose th { background: var(--color-slate-800); }
  .prose hr {
    border: 0;
    border-top: 1px solid var(--color-slate-200);
    margin: 2rem 0;
  }
  .dark .prose hr { border-top-color: var(--color-slate-700); }

  .prose .business-plan-cta {
    margin: 1.25rem 0 1.75rem;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--color-brand);
    background: linear-gradient(135deg, rgb(30 58 138 / 0.05) 0%, var(--color-white) 100%);
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
  }
  .dark .prose .business-plan-cta {
    background: linear-gradient(135deg, rgb(51 133 214 / 0.08) 0%, rgb(15 23 42 / 0.5) 100%);
    border-left-color: var(--color-brand);
  }
  .prose .business-plan-cta a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-brand);
    text-decoration: none;
    font-weight: 700;
  }
  .prose .business-plan-cta a::before {
    content: '⬇';
    display: inline-block;
    font-size: 0.875rem;
  }
  .prose .business-plan-cta a:hover { text-decoration: underline; }

  .loading { color: var(--color-slate-500); padding: 4rem 0; text-align: center; }
</style>
